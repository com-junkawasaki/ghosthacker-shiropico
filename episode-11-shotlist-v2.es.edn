[{:db/id -1, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "geothermal_plant_dawn", :shotlist.episode11.es/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.es/sfx "ambient", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 3.5} {:db/id -2, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "control_room", :shotlist.episode11.es/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.0} {:db/id -3, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "corridor_shadow", :shotlist.episode11.es/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 2.5} {:db/id -4, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "...Ahí está.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "normal", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -5, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "plant_fence", :shotlist.episode11.es/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.es/sfx "ambient", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 2.5} {:db/id -6, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡Espérame, SHIRO! ¡¿Por qué empezaste a correr así?!", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx "whoosh", :shotlist.episode11.es/fx nil} {:db/id -7, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Vamos a entrar. Aquí hay algo raro.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "confused", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -8, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¿Raro cómo? Los logs estaban todos limpios, ¿no?", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "confused", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -9, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "...¿De verdad lo crees?", :shotlist.episode11.es/shiro_emo "smug", :shotlist.episode11.es/pico_emo "confused", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -10, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "Claro que sí. Si no hay nada, no hay nada.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -11, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "control_room", :shotlist.episode11.es/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 2.5} {:db/id -12, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¿Ves? Te lo dije. ¡Los logs están limpios! Pan comido, soy un genio.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "smug", :shotlist.episode11.es/sfx "pop", :shotlist.episode11.es/fx nil} {:db/id -13, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¿Qué? Ya está resuelto. Vámonos a casa.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -14, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "deep_pipes", :shotlist.episode11.es/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.es/sfx "alarm", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 2.5} {:db/id -15, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "...", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "alarm", :shotlist.episode11.es/fx nil} {:db/id -16, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡¿Eh?! ¡¿Por qué?! ¡Estaba todo limpio!", :shotlist.episode11.es/shiro_emo "surprised", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx "alarm", :shotlist.episode11.es/fx "shake"} {:db/id -17, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "control_room", :shotlist.episode11.es/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.es/sfx "alarm", :shotlist.episode11.es/fx "shake", :shotlist.episode11.es/dur 3.0} {:db/id -18, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡Aaah! ¡No doy abasto! ¡Volvió a desaparecer!", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx "alarm", :shotlist.episode11.es/fx "shake"} {:db/id -19, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡¿Cómo crece si no para de desaparecer?!", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx "shake"} {:db/id -20, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "PICO. \"Desapareció\"... ¿de verdad?", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -21, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡Es verdad! Los logs...", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -22, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Solo hacen que PAREZCA que desaparecieron.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -23, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "La información es física. Si la borras, siempre queda calor.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -24, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "...¿Ves? El calor blanco sigue ahí.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx "flash"} {:db/id -25, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "heat_residue", :shotlist.episode11.es/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.0} {:db/id -26, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "...Ah. Ahí está. Allá lejos.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -27, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Aunque creas que se fue, la luz queda. Vamos.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "normal", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -28, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "henshin_bank", :shotlist.episode11.es/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.5} {:db/id -29, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "¡SHIRO-PICO, ON!", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash"} {:db/id -30, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "info_layer", :shotlist.episode11.es/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.es/sfx "whoosh", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 3.0} {:db/id -31, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "PICO, sigue el rastro de calor blanco. Tú eres más rápido.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -32, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡Déjamelo a mí! ¡Técnica: Heat-Trace Rush!", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "whoosh", :shotlist.episode11.es/fx "flash"} {:db/id -33, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "info_layer", :shotlist.episode11.es/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.es/sfx "whoosh", :shotlist.episode11.es/fx "shake", :shotlist.episode11.es/dur 3.0} {:db/id -34, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡Se está conectando! ¡Todo va hacia el core server!", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -35, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Esa es la entrada.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "normal", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -36, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "core_server", :shotlist.episode11.es/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 3.5} {:db/id -37, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "...¿Qué es eso?", :shotlist.episode11.es/shiro_emo "surprised", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx nil} {:db/id -38, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "—Ghost.", :shotlist.episode11.es/shiro_emo "surprised", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx "flash"} {:db/id -39, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "ghost_reveal", :shotlist.episode11.es/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 4.0} {:db/id -40, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "...Apareció. Es el de verdad.", :shotlist.episode11.es/shiro_emo "surprised", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -41, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "ghost_reveal", :shotlist.episode11.es/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.es/sfx "alarm", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.0} {:db/id -42, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "PICO, aléjate.", :shotlist.episode11.es/shiro_emo "angry", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -43, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Ahora mismo.", :shotlist.episode11.es/shiro_emo "angry", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx "shake"} {:db/id -44, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "—Visible Thread.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx "whoosh", :shotlist.episode11.es/fx "flash"} {:db/id -45, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "ghost_reveal", :shotlist.episode11.es/scene_prompt "Thin teal threads of light extend trying to trace and outline the faceless white-heat Ghost silhouette, the threads strike its edge and snap back repelled, recoil shockwave, ominous cyber neon", :shotlist.episode11.es/sfx "whoosh", :shotlist.episode11.es/fx "shake", :shotlist.episode11.es/dur 3.0} {:db/id -46, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡¿SHIRO?!", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx "shake"} {:db/id -47, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "...Es fuerte. La tecnología de hoy no puede revelarlo entero.", :shotlist.episode11.es/shiro_emo "sad", :shotlist.episode11.es/pico_emo "panic", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -48, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡¿No lo vas a perseguir?!", :shotlist.episode11.es/shiro_emo "sad", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -49, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "...No puedo. Ahora no.", :shotlist.episode11.es/shiro_emo "sad", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -50, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "ghost_reveal", :shotlist.episode11.es/scene_prompt "The faceless Ghost silhouette dissolving back into white heat particles, and at the instant of vanishing a single teal mote of light glows within its outline then fades, ominous and mysterious, cyber neon", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.5} {:db/id -51, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "SHIRO. Dentro de él... una luz turquesa.", :shotlist.episode11.es/shiro_emo "surprised", :shotlist.episode11.es/pico_emo "surprised", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -52, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "...¿Tú también la viste?", :shotlist.episode11.es/shiro_emo "surprised", :shotlist.episode11.es/pico_emo "normal", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -53, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "La información es física. Aunque se borre, siempre queda un rastro.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "normal", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -54, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Vamos a deshacer cada comando que el Ghost reescribió.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "normal", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -55, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡Técnica: Heat-Memory Restore!", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "whoosh", :shotlist.episode11.es/fx "flash"} {:db/id -56, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "info_layer", :shotlist.episode11.es/scene_prompt "Streams of white heat particles flowing into server racks, overwritten commands restoring to original form, teal restore-light spreading across the data layer, cyber neon recovery glow", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.0} {:db/id -57, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Técnica: Full-Spectrum Scan... lo recogemos todo.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash"} {:db/id -58, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "info_layer", :shotlist.episode11.es/scene_prompt "Plant-wide teal scan light sweeping across the whole facility, every spot the Ghost touched lighting up as white heat afterimages, altered values and fake commands all exposed, cyber neon", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.0} {:db/id -59, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡Marchando!", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "whoosh", :shotlist.episode11.es/fx nil} {:db/id -60, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "—¡Double Remanence Reset!", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash"} {:db/id -61, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "—¡Double Remanence Reset!", :shotlist.episode11.es/shiro_emo "happy", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash"} {:db/id -62, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "plant_restored", :shotlist.episode11.es/scene_prompt "Teal and white light merging in a ripple across the whole geothermal plant, red values reverting to normal, pipe pressure easing, steam settling, alarms silenced, triumphant cyber neon dawn", :shotlist.episode11.es/sfx "ambient", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.5} {:db/id -63, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "geothermal_plant_dawn", :shotlist.episode11.es/scene_prompt "Exterior plant wall at brightening dawn, two small chibi hero silhouettes sitting side by side on the wall, steam columns flushed with morning light, calm teal sky, quiet aftermath", :shotlist.episode11.es/sfx "ambient", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 3.0} {:db/id -64, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "...SHIRO. El Ghost era fuerte, ¿eh?", :shotlist.episode11.es/shiro_emo "sad", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -65, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Sí.", :shotlist.episode11.es/shiro_emo "sad", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -66, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "...¿Ni siquiera tú puedes ganarle?", :shotlist.episode11.es/shiro_emo "sad", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -67, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "El Ghost es demasiado bueno borrando.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -68, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Pero no puede borrar del todo. Algún día lo veremos, seguro.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "normal", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -69, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "Me pregunto qué era eso. Esa luz.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "thinking", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -70, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "...Yo tampoco lo sé todavía.", :shotlist.episode11.es/shiro_emo "thinking", :shotlist.episode11.es/pico_emo "thinking", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -71, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "Antes se me daba bien borrar logs. Para que nadie lo notara.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -72, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "...Pero hoy nada desapareció. Todo sigue aquí.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -73, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "...Me pregunto si lo que hice también sigue aquí.", :shotlist.episode11.es/shiro_emo "sad", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -74, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Vamos, PICO. —Al siguiente pueblo.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "sad", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -75, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "...Si no se fue, entonces tengo que afrontarlo.", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "thinking", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -76, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "geothermal_plant_dawn", :shotlist.episode11.es/scene_prompt "Distant plant view in morning light, for one instant white heat-haze forms a faceless humanoid silhouette then vanishes, a single teal mote glowing within its outline before fading, ominous mysterious cyber neon, To be continued", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx "flash", :shotlist.episode11.es/dur 3.5} {:db/id -77, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "zukan_corner", :shotlist.episode11.es/scene_prompt "Bright clean whiteboard channel-style corner, friendly studio lighting, a hand cupping glowing white light particles, teal accent graphics, cheerful educational cyber vibe, character-free", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 2.5} {:db/id -78, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¡¿Qué es eso de \"data remanence\" de hoy?!", :shotlist.episode11.es/shiro_emo "normal", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "pop", :shotlist.episode11.es/fx nil} {:db/id -79, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Data remanence = datos residuales. Aunque borres, queda un rastro.", :shotlist.episode11.es/shiro_emo "happy", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -80, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "El principio de Landauer. Borrar siempre cuesta calor.", :shotlist.episode11.es/shiro_emo "happy", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -81, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "pico", :shotlist.episode11.es/text "¿Entonces aunque borres un log, te pillan?", :shotlist.episode11.es/shiro_emo "happy", :shotlist.episode11.es/pico_emo "confused", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -82, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "Exacto. Las herramientas de forensics rescatan los rastros.", :shotlist.episode11.es/shiro_emo "happy", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx nil, :shotlist.episode11.es/fx nil} {:db/id -83, :shotlist.episode11.es/type "dialogue", :shotlist.episode11.es/speaker "shiro", :shotlist.episode11.es/text "La información es física. Aunque se borre, la luz queda.", :shotlist.episode11.es/shiro_emo "happy", :shotlist.episode11.es/pico_emo "happy", :shotlist.episode11.es/sfx "chime", :shotlist.episode11.es/fx "flash"} {:db/id -84, :shotlist.episode11.es/type "scene", :shotlist.episode11.es/scene_key "ed_hideandseek", :shotlist.episode11.es/scene_prompt "Soft teal cyber dusk ED scene, a faceless white heat-haze Ghost silhouette peeking shyly then hiding, within its outline a single teal mote of light stays glowing and does not fade, gentle ominous warmth, neon", :shotlist.episode11.es/sfx "ghost", :shotlist.episode11.es/fx nil, :shotlist.episode11.es/dur 3.0}]