[{:db/id -1, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "geothermal_plant_dawn", :shotlist.episode11.hi/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.hi/sfx "ambient", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 3.5} {:db/id -2, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "control_room", :shotlist.episode11.hi/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.0} {:db/id -3, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "corridor_shadow", :shotlist.episode11.hi/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 2.5} {:db/id -4, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "…वहाँ है।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "normal", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -5, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "plant_fence", :shotlist.episode11.hi/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.hi/sfx "ambient", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 2.5} {:db/id -6, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "रुको ना SHIRO~! अचानक भागने क्यों लगी!?", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx "whoosh", :shotlist.episode11.hi/fx nil} {:db/id -7, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "अंदर चलते हैं। यहाँ कुछ गड़बड़ है।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "confused", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -8, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "गड़बड़ कैसे? logs तो सब साफ़ थे ना?", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "confused", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -9, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "…सच में ऐसा लगता है?", :shotlist.episode11.hi/shiro_emo "smug", :shotlist.episode11.hi/pico_emo "confused", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -10, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "बिल्कुल। जो नहीं है, वो नहीं है।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -11, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "control_room", :shotlist.episode11.hi/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 2.5} {:db/id -12, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "देखा~ कहा था ना। logs सब साफ़! आसान, मैं जीनियस हूँ।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "smug", :shotlist.episode11.hi/sfx "pop", :shotlist.episode11.hi/fx nil} {:db/id -13, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "क्या? हो गया हल। चलो घर चलें~", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -14, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "deep_pipes", :shotlist.episode11.hi/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.hi/sfx "alarm", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 2.5} {:db/id -15, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "…", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "alarm", :shotlist.episode11.hi/fx nil} {:db/id -16, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "हें!? क्यों!? अभी तो सब साफ़ था!", :shotlist.episode11.hi/shiro_emo "surprised", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx "alarm", :shotlist.episode11.hi/fx "shake"} {:db/id -17, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "control_room", :shotlist.episode11.hi/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.hi/sfx "alarm", :shotlist.episode11.hi/fx "shake", :shotlist.episode11.hi/dur 3.0} {:db/id -18, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "वाह! संभाल ही नहीं पा रहा! फिर से गायब!", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx "alarm", :shotlist.episode11.hi/fx "shake"} {:db/id -19, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "गायब हो रहा है फिर भी बढ़ क्यों रहा है!!", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx "shake"} {:db/id -20, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "PICO। \"गायब हो गया\"—सच में?", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -21, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "सच में! logs वो—", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -22, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "बस \"गायब दिखने\" का भ्रम बनाया जा रहा है।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -23, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "जानकारी भौतिक है। मिटाओ तो गर्मी ज़रूर बच जाती है।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -24, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "…देखो। सफ़ेद गर्मी, अभी भी बची है।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx "flash"} {:db/id -25, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "heat_residue", :shotlist.episode11.hi/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.0} {:db/id -26, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "…अरे। मिल गया। वहाँ उस जगह।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -27, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "मिट गया लगे फिर भी, रोशनी बची रहती है। चलो।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "normal", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -28, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "henshin_bank", :shotlist.episode11.hi/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.5} {:db/id -29, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "SHIRO-PICO, ON!", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash"} {:db/id -30, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "info_layer", :shotlist.episode11.hi/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.hi/sfx "whoosh", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 3.0} {:db/id -31, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "PICO, सफ़ेद गर्मी के निशान का पीछा करो। तेज़ तुम हो।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -32, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "छोड़ दो मुझ पर! दाँव, Heat-Trace Rush!", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "whoosh", :shotlist.episode11.hi/fx "flash"} {:db/id -33, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "info_layer", :shotlist.episode11.hi/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.hi/sfx "whoosh", :shotlist.episode11.hi/fx "shake", :shotlist.episode11.hi/dur 3.0} {:db/id -34, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "जुड़ने लगा! सब core server की तरफ़ जा रहे हैं!", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -35, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "वहीं, रास्ता है।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "normal", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -36, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "core_server", :shotlist.episode11.hi/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 3.5} {:db/id -37, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "…वो, क्या है?", :shotlist.episode11.hi/shiro_emo "surprised", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx nil} {:db/id -38, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "—Ghost।", :shotlist.episode11.hi/shiro_emo "surprised", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx "flash"} {:db/id -39, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "ghost_reveal", :shotlist.episode11.hi/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 4.0} {:db/id -40, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "…आ गया। असली वाला।", :shotlist.episode11.hi/shiro_emo "surprised", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -41, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "ghost_reveal", :shotlist.episode11.hi/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.hi/sfx "alarm", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.0} {:db/id -42, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "PICO, दूरी बना लो।", :shotlist.episode11.hi/shiro_emo "angry", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -43, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "अभी।", :shotlist.episode11.hi/shiro_emo "angry", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx "shake"} {:db/id -44, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "—Visible Thread।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx "whoosh", :shotlist.episode11.hi/fx "flash"} {:db/id -45, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "ghost_reveal", :shotlist.episode11.hi/scene_prompt "Thin teal threads of light extend trying to trace and outline the faceless white-heat Ghost silhouette, the threads strike its edge and snap back repelled, recoil shockwave, ominous cyber neon", :shotlist.episode11.hi/sfx "whoosh", :shotlist.episode11.hi/fx "shake", :shotlist.episode11.hi/dur 3.0} {:db/id -46, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "SHIRO!?", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx "shake"} {:db/id -47, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "…ताक़तवर है। आज की तकनीक से, पूरा नहीं दिखता।", :shotlist.episode11.hi/shiro_emo "sad", :shotlist.episode11.hi/pico_emo "panic", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -48, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "पीछा नहीं करोगी!?", :shotlist.episode11.hi/shiro_emo "sad", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -49, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "…नहीं कर सकती। अभी नहीं।", :shotlist.episode11.hi/shiro_emo "sad", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -50, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "ghost_reveal", :shotlist.episode11.hi/scene_prompt "The faceless Ghost silhouette dissolving back into white heat particles, and at the instant of vanishing a single teal mote of light glows within its outline then fades, ominous and mysterious, cyber neon", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.5} {:db/id -51, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "SHIRO। उसके अंदर—फ़िरोज़ी, रोशनी।", :shotlist.episode11.hi/shiro_emo "surprised", :shotlist.episode11.hi/pico_emo "surprised", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -52, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "…तुमने भी देखी?", :shotlist.episode11.hi/shiro_emo "surprised", :shotlist.episode11.hi/pico_emo "normal", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -53, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "जानकारी भौतिक है। मिट भी जाए तो, निशान ज़रूर रहता है।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "normal", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -54, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "Ghost ने जो command बदले, सब वापस ठीक करेंगे।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "normal", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -55, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "दाँव, Heat-Memory Restore!", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "whoosh", :shotlist.episode11.hi/fx "flash"} {:db/id -56, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "info_layer", :shotlist.episode11.hi/scene_prompt "Streams of white heat particles flowing into server racks, overwritten commands restoring to original form, teal restore-light spreading across the data layer, cyber neon recovery glow", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.0} {:db/id -57, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "दाँव, Full-Spectrum Scan—सब बटोर लेंगे।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash"} {:db/id -58, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "info_layer", :shotlist.episode11.hi/scene_prompt "Plant-wide teal scan light sweeping across the whole facility, every spot the Ghost touched lighting up as white heat afterimages, altered values and fake commands all exposed, cyber neon", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.0} {:db/id -59, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "हाँ जी!", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "whoosh", :shotlist.episode11.hi/fx nil} {:db/id -60, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "—Double Remanence Reset!", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash"} {:db/id -61, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "—Double Remanence Reset!", :shotlist.episode11.hi/shiro_emo "happy", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash"} {:db/id -62, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "plant_restored", :shotlist.episode11.hi/scene_prompt "Teal and white light merging in a ripple across the whole geothermal plant, red values reverting to normal, pipe pressure easing, steam settling, alarms silenced, triumphant cyber neon dawn", :shotlist.episode11.hi/sfx "ambient", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.5} {:db/id -63, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "geothermal_plant_dawn", :shotlist.episode11.hi/scene_prompt "Exterior plant wall at brightening dawn, two small chibi hero silhouettes sitting side by side on the wall, steam columns flushed with morning light, calm teal sky, quiet aftermath", :shotlist.episode11.hi/sfx "ambient", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 3.0} {:db/id -64, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "…SHIRO। Ghost, ताक़तवर था ना।", :shotlist.episode11.hi/shiro_emo "sad", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -65, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "हाँ।", :shotlist.episode11.hi/shiro_emo "sad", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -66, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "…SHIRO भी नहीं जीत सकती?", :shotlist.episode11.hi/shiro_emo "sad", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -67, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "Ghost, मिटाने में बहुत माहिर है।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -68, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "पर पूरी तरह नहीं मिटता। किसी दिन ज़रूर दिखेगा।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "normal", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -69, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "वो आख़िर था क्या। वो रोशनी।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "thinking", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -70, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "…मुझे भी, अभी पता नहीं।", :shotlist.episode11.hi/shiro_emo "thinking", :shotlist.episode11.hi/pico_emo "thinking", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -71, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "पहले मैं logs मिटाने में माहिर था। ताकि किसी को पता न चले।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -72, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "…पर आज, कुछ नहीं मिटा। सब बचा हुआ है।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -73, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "…जो मैंने किया, वो भी बचा होगा क्या।", :shotlist.episode11.hi/shiro_emo "sad", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -74, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "चलो, PICO। —अगले शहर।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "sad", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -75, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "…अगर नहीं मिटा, तो सामना करना ही होगा।", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "thinking", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -76, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "geothermal_plant_dawn", :shotlist.episode11.hi/scene_prompt "Distant plant view in morning light, for one instant white heat-haze forms a faceless humanoid silhouette then vanishes, a single teal mote glowing within its outline before fading, ominous mysterious cyber neon, To be continued", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx "flash", :shotlist.episode11.hi/dur 3.5} {:db/id -77, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "zukan_corner", :shotlist.episode11.hi/scene_prompt "Bright clean whiteboard channel-style corner, friendly studio lighting, a hand cupping glowing white light particles, teal accent graphics, cheerful educational cyber vibe, character-free", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 2.5} {:db/id -78, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "आज का \"data remanence\" क्या है!?", :shotlist.episode11.hi/shiro_emo "normal", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "pop", :shotlist.episode11.hi/fx nil} {:db/id -79, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "Data remanence＝डेटा अवशेष। मिटाओ फिर भी निशान रहता है।", :shotlist.episode11.hi/shiro_emo "happy", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -80, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "लांडाउर का सिद्धांत। मिटाने में हमेशा गर्मी लगती है।", :shotlist.episode11.hi/shiro_emo "happy", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -81, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "pico", :shotlist.episode11.hi/text "तो log मिट भी जाए, तब भी पकड़े जाओगे?", :shotlist.episode11.hi/shiro_emo "happy", :shotlist.episode11.hi/pico_emo "confused", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -82, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "हाँ। forensics tools निशान खोद निकालते हैं।", :shotlist.episode11.hi/shiro_emo "happy", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx nil, :shotlist.episode11.hi/fx nil} {:db/id -83, :shotlist.episode11.hi/type "dialogue", :shotlist.episode11.hi/speaker "shiro", :shotlist.episode11.hi/text "जानकारी भौतिक है। मिट भी जाए तो, रोशनी बची रहती है✨", :shotlist.episode11.hi/shiro_emo "happy", :shotlist.episode11.hi/pico_emo "happy", :shotlist.episode11.hi/sfx "chime", :shotlist.episode11.hi/fx "flash"} {:db/id -84, :shotlist.episode11.hi/type "scene", :shotlist.episode11.hi/scene_key "ed_hideandseek", :shotlist.episode11.hi/scene_prompt "Soft teal cyber dusk ED scene, a faceless white heat-haze Ghost silhouette peeking shyly then hiding, within its outline a single teal mote of light stays glowing and does not fade, gentle ominous warmth, neon", :shotlist.episode11.hi/sfx "ghost", :shotlist.episode11.hi/fx nil, :shotlist.episode11.hi/dur 3.0}]