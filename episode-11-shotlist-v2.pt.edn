[{:db/id -1, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "geothermal_plant_dawn", :shotlist.episode11.pt/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.pt/sfx "ambient", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 3.5} {:db/id -2, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "control_room", :shotlist.episode11.pt/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.0} {:db/id -3, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "corridor_shadow", :shotlist.episode11.pt/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 2.5} {:db/id -4, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "...Ali está.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "normal", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -5, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "plant_fence", :shotlist.episode11.pt/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.pt/sfx "ambient", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 2.5} {:db/id -6, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Espera, SHIRO! Por que saiu correndo assim?!", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx "whoosh", :shotlist.episode11.pt/fx nil} {:db/id -7, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Vamos entrar. Tem algo estranho aqui.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "confused", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -8, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Estranho como? Os logs estavam todos limpos, não?", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "confused", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -9, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "...Você acha mesmo?", :shotlist.episode11.pt/shiro_emo "smug", :shotlist.episode11.pt/pico_emo "confused", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -10, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Claro que acho. Se não tem nada, não tem nada.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -11, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "control_room", :shotlist.episode11.pt/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 2.5} {:db/id -12, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Viu? Eu disse. Logs todos limpos! Moleza, sou um gênio.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "smug", :shotlist.episode11.pt/sfx "pop", :shotlist.episode11.pt/fx nil} {:db/id -13, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "O quê? Já está resolvido. Vamos pra casa.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -14, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "deep_pipes", :shotlist.episode11.pt/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.pt/sfx "alarm", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 2.5} {:db/id -15, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "...", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "alarm", :shotlist.episode11.pt/fx nil} {:db/id -16, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Hã?! Por quê?! Estava tudo limpo!", :shotlist.episode11.pt/shiro_emo "surprised", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx "alarm", :shotlist.episode11.pt/fx "shake"} {:db/id -17, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "control_room", :shotlist.episode11.pt/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.pt/sfx "alarm", :shotlist.episode11.pt/fx "shake", :shotlist.episode11.pt/dur 3.0} {:db/id -18, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Uau! Não consigo acompanhar! Sumiu de novo!", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx "alarm", :shotlist.episode11.pt/fx "shake"} {:db/id -19, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Como está aumentando se não para de sumir?!", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx "shake"} {:db/id -20, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "PICO. \"Sumiu\"... será mesmo?", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -21, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "É verdade! Os logs...", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -22, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Só estão fazendo PARECER que sumiram.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -23, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "A informação é física. Ao apagar, sempre sobra calor.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -24, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "...Viu? O calor branco ainda está aí.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx "flash"} {:db/id -25, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "heat_residue", :shotlist.episode11.pt/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.0} {:db/id -26, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "...Ah. Ali está. Lá longe.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -27, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Mesmo achando que sumiu, a luz fica. Vamos.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "normal", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -28, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "henshin_bank", :shotlist.episode11.pt/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.5} {:db/id -29, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "SHIRO-PICO, ON!", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash"} {:db/id -30, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "info_layer", :shotlist.episode11.pt/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.pt/sfx "whoosh", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 3.0} {:db/id -31, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "PICO, siga o rastro de calor branco. Você é mais rápido.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -32, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Deixa comigo! Golpe: Heat-Trace Rush!", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "whoosh", :shotlist.episode11.pt/fx "flash"} {:db/id -33, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "info_layer", :shotlist.episode11.pt/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.pt/sfx "whoosh", :shotlist.episode11.pt/fx "shake", :shotlist.episode11.pt/dur 3.0} {:db/id -34, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Está conectando! Tudo vai pro core server!", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -35, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "É ali a entrada.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "normal", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -36, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "core_server", :shotlist.episode11.pt/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 3.5} {:db/id -37, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "...O que é aquilo?", :shotlist.episode11.pt/shiro_emo "surprised", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx nil} {:db/id -38, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "—Ghost.", :shotlist.episode11.pt/shiro_emo "surprised", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx "flash"} {:db/id -39, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "ghost_reveal", :shotlist.episode11.pt/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 4.0} {:db/id -40, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "...Apareceu. É o de verdade.", :shotlist.episode11.pt/shiro_emo "surprised", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -41, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "ghost_reveal", :shotlist.episode11.pt/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.pt/sfx "alarm", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.0} {:db/id -42, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "PICO, se afaste.", :shotlist.episode11.pt/shiro_emo "angry", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -43, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Agora.", :shotlist.episode11.pt/shiro_emo "angry", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx "shake"} {:db/id -44, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "—Visible Thread.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx "whoosh", :shotlist.episode11.pt/fx "flash"} {:db/id -45, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "ghost_reveal", :shotlist.episode11.pt/scene_prompt "Thin teal threads of light extend trying to trace and outline the faceless white-heat Ghost silhouette, the threads strike its edge and snap back repelled, recoil shockwave, ominous cyber neon", :shotlist.episode11.pt/sfx "whoosh", :shotlist.episode11.pt/fx "shake", :shotlist.episode11.pt/dur 3.0} {:db/id -46, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "SHIRO?!", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx "shake"} {:db/id -47, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "...É forte. A tecnologia de hoje não consegue revelar tudo.", :shotlist.episode11.pt/shiro_emo "sad", :shotlist.episode11.pt/pico_emo "panic", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -48, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Não vai atrás dele?!", :shotlist.episode11.pt/shiro_emo "sad", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -49, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "...Não posso. Agora não.", :shotlist.episode11.pt/shiro_emo "sad", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -50, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "ghost_reveal", :shotlist.episode11.pt/scene_prompt "The faceless Ghost silhouette dissolving back into white heat particles, and at the instant of vanishing a single teal mote of light glows within its outline then fades, ominous and mysterious, cyber neon", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.5} {:db/id -51, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "SHIRO. Dentro dele... uma luz turquesa.", :shotlist.episode11.pt/shiro_emo "surprised", :shotlist.episode11.pt/pico_emo "surprised", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -52, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "...Você também viu?", :shotlist.episode11.pt/shiro_emo "surprised", :shotlist.episode11.pt/pico_emo "normal", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -53, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "A informação é física. Mesmo apagada, sempre sobra um rastro.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "normal", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -54, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Vamos desfazer cada comando que o Ghost reescreveu.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "normal", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -55, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Golpe: Heat-Memory Restore!", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "whoosh", :shotlist.episode11.pt/fx "flash"} {:db/id -56, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "info_layer", :shotlist.episode11.pt/scene_prompt "Streams of white heat particles flowing into server racks, overwritten commands restoring to original form, teal restore-light spreading across the data layer, cyber neon recovery glow", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.0} {:db/id -57, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Golpe: Full-Spectrum Scan... pegamos tudo.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash"} {:db/id -58, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "info_layer", :shotlist.episode11.pt/scene_prompt "Plant-wide teal scan light sweeping across the whole facility, every spot the Ghost touched lighting up as white heat afterimages, altered values and fake commands all exposed, cyber neon", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.0} {:db/id -59, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "É pra já!", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "whoosh", :shotlist.episode11.pt/fx nil} {:db/id -60, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "—Double Remanence Reset!", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash"} {:db/id -61, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "—Double Remanence Reset!", :shotlist.episode11.pt/shiro_emo "happy", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash"} {:db/id -62, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "plant_restored", :shotlist.episode11.pt/scene_prompt "Teal and white light merging in a ripple across the whole geothermal plant, red values reverting to normal, pipe pressure easing, steam settling, alarms silenced, triumphant cyber neon dawn", :shotlist.episode11.pt/sfx "ambient", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.5} {:db/id -63, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "geothermal_plant_dawn", :shotlist.episode11.pt/scene_prompt "Exterior plant wall at brightening dawn, two small chibi hero silhouettes sitting side by side on the wall, steam columns flushed with morning light, calm teal sky, quiet aftermath", :shotlist.episode11.pt/sfx "ambient", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 3.0} {:db/id -64, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "...SHIRO. O Ghost era forte, né.", :shotlist.episode11.pt/shiro_emo "sad", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -65, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "É.", :shotlist.episode11.pt/shiro_emo "sad", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -66, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "...Nem você consegue vencê-lo?", :shotlist.episode11.pt/shiro_emo "sad", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -67, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "O Ghost é bom demais em apagar.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -68, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Mas não apaga por completo. Um dia, com certeza, vamos vê-lo.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "normal", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -69, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Fico pensando no que era aquilo. Aquela luz.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "thinking", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -70, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "...Eu também ainda não sei.", :shotlist.episode11.pt/shiro_emo "thinking", :shotlist.episode11.pt/pico_emo "thinking", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -71, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Antes eu era bom em apagar logs. Pra ninguém perceber.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -72, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "...Mas hoje, nada sumiu. Está tudo aqui ainda.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -73, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "...Será que o que eu fiz também ainda está aqui.", :shotlist.episode11.pt/shiro_emo "sad", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -74, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Vamos, PICO. —Pra próxima cidade.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "sad", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -75, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "...Se não sumiu, então tenho que encarar.", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "thinking", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -76, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "geothermal_plant_dawn", :shotlist.episode11.pt/scene_prompt "Distant plant view in morning light, for one instant white heat-haze forms a faceless humanoid silhouette then vanishes, a single teal mote glowing within its outline before fading, ominous mysterious cyber neon, To be continued", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx "flash", :shotlist.episode11.pt/dur 3.5} {:db/id -77, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "zukan_corner", :shotlist.episode11.pt/scene_prompt "Bright clean whiteboard channel-style corner, friendly studio lighting, a hand cupping glowing white light particles, teal accent graphics, cheerful educational cyber vibe, character-free", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 2.5} {:db/id -78, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "O que é o \"data remanence\" de hoje?!", :shotlist.episode11.pt/shiro_emo "normal", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "pop", :shotlist.episode11.pt/fx nil} {:db/id -79, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Data remanence = dados residuais. Mesmo apagando, sobra um rastro.", :shotlist.episode11.pt/shiro_emo "happy", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -80, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "O princípio de Landauer. Apagar sempre custa calor.", :shotlist.episode11.pt/shiro_emo "happy", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -81, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "pico", :shotlist.episode11.pt/text "Então mesmo apagando um log, dá pra te pegar?", :shotlist.episode11.pt/shiro_emo "happy", :shotlist.episode11.pt/pico_emo "confused", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -82, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "Isso. As ferramentas de forensics recuperam os rastros.", :shotlist.episode11.pt/shiro_emo "happy", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx nil, :shotlist.episode11.pt/fx nil} {:db/id -83, :shotlist.episode11.pt/type "dialogue", :shotlist.episode11.pt/speaker "shiro", :shotlist.episode11.pt/text "A informação é física. Mesmo apagada, a luz fica.", :shotlist.episode11.pt/shiro_emo "happy", :shotlist.episode11.pt/pico_emo "happy", :shotlist.episode11.pt/sfx "chime", :shotlist.episode11.pt/fx "flash"} {:db/id -84, :shotlist.episode11.pt/type "scene", :shotlist.episode11.pt/scene_key "ed_hideandseek", :shotlist.episode11.pt/scene_prompt "Soft teal cyber dusk ED scene, a faceless white heat-haze Ghost silhouette peeking shyly then hiding, within its outline a single teal mote of light stays glowing and does not fade, gentle ominous warmth, neon", :shotlist.episode11.pt/sfx "ghost", :shotlist.episode11.pt/fx nil, :shotlist.episode11.pt/dur 3.0}]