[{:db/id -1, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "geothermal_plant_dawn", :shotlist.episode11.zh/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.zh/sfx "ambient", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 3.5} {:db/id -2, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "control_room", :shotlist.episode11.zh/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.0} {:db/id -3, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "corridor_shadow", :shotlist.episode11.zh/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 2.5} {:db/id -4, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "……找到了。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "normal", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -5, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "plant_fence", :shotlist.episode11.zh/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.zh/sfx "ambient", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 2.5} {:db/id -6, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "等等啊SHIRO～！干嘛突然就跑起来！？", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx "whoosh", :shotlist.episode11.zh/fx nil} {:db/id -7, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "进去看看。这里不对劲。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "confused", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -8, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "哪里不对？日志不是全都干净吗？", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "confused", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -9, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "……你真这么觉得？", :shotlist.episode11.zh/shiro_emo "smug", :shotlist.episode11.zh/pico_emo "confused", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -10, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "当然啦。没有的东西就是没有嘛。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -11, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "control_room", :shotlist.episode11.zh/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 2.5} {:db/id -12, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "看吧～果然。日志全都干净！轻松搞定，我天才。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "smug", :shotlist.episode11.zh/sfx "pop", :shotlist.episode11.zh/fx nil} {:db/id -13, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "怎么了？都解决了。回家吧～", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -14, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "deep_pipes", :shotlist.episode11.zh/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.zh/sfx "alarm", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 2.5} {:db/id -15, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "……", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "alarm", :shotlist.episode11.zh/fx nil} {:db/id -16, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "诶？！为什么！？刚才明明都干净的！", :shotlist.episode11.zh/shiro_emo "surprised", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx "alarm", :shotlist.episode11.zh/fx "shake"} {:db/id -17, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "control_room", :shotlist.episode11.zh/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.zh/sfx "alarm", :shotlist.episode11.zh/fx "shake", :shotlist.episode11.zh/dur 3.0} {:db/id -18, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "哇——！跟不上了！又消失了！", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx "alarm", :shotlist.episode11.zh/fx "shake"} {:db/id -19, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "明明在消失却又在增加是怎么回事！！", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx "shake"} {:db/id -20, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "PICO。所谓“消失”——真的吗？", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -21, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "真的啦！日志它——", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -22, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "是被弄得“看起来像消失了”而已。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -23, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "信息是物理的。一删除，必定会残留热。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -24, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "……你看。白色的热，还残留着。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx "flash"} {:db/id -25, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "heat_residue", :shotlist.episode11.zh/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.0} {:db/id -26, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "……啊。有了。在那种地方。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -27, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "就算以为消失了，光也会留下。走吧。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "normal", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -28, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "henshin_bank", :shotlist.episode11.zh/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.5} {:db/id -29, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "SHIRO-PICO，ON！", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash"} {:db/id -30, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "info_layer", :shotlist.episode11.zh/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.zh/sfx "whoosh", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 3.0} {:db/id -31, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "PICO，追白色热痕。速度你更快。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -32, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "交给我！招式，Heat-Trace Rush！", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "whoosh", :shotlist.episode11.zh/fx "flash"} {:db/id -33, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "info_layer", :shotlist.episode11.zh/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.zh/sfx "whoosh", :shotlist.episode11.zh/fx "shake", :shotlist.episode11.zh/dur 3.0} {:db/id -34, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "连起来了！全都朝着core server去！", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -35, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "那里，就是入口。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "normal", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -36, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "core_server", :shotlist.episode11.zh/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 3.5} {:db/id -37, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "……那是，什么？", :shotlist.episode11.zh/shiro_emo "surprised", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx nil} {:db/id -38, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "——Ghost。", :shotlist.episode11.zh/shiro_emo "surprised", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx "flash"} {:db/id -39, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "ghost_reveal", :shotlist.episode11.zh/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 4.0} {:db/id -40, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "……出现了。是真货。", :shotlist.episode11.zh/shiro_emo "surprised", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -41, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "ghost_reveal", :shotlist.episode11.zh/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.zh/sfx "alarm", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.0} {:db/id -42, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "PICO，拉开距离。", :shotlist.episode11.zh/shiro_emo "angry", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -43, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "现在就走。", :shotlist.episode11.zh/shiro_emo "angry", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx "shake"} {:db/id -44, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "——Visible Thread。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx "whoosh", :shotlist.episode11.zh/fx "flash"} {:db/id -45, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "ghost_reveal", :shotlist.episode11.zh/scene_prompt "Thin teal threads of light extend trying to trace and outline the faceless white-heat Ghost silhouette, the threads strike its edge and snap back repelled, recoil shockwave, ominous cyber neon", :shotlist.episode11.zh/sfx "whoosh", :shotlist.episode11.zh/fx "shake", :shotlist.episode11.zh/dur 3.0} {:db/id -46, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "SHIRO！？", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx "shake"} {:db/id -47, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "……很强。用现在的技术，看不到全部。", :shotlist.episode11.zh/shiro_emo "sad", :shotlist.episode11.zh/pico_emo "panic", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -48, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "不追它吗！？", :shotlist.episode11.zh/shiro_emo "sad", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -49, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "……追不上。现在不行。", :shotlist.episode11.zh/shiro_emo "sad", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -50, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "ghost_reveal", :shotlist.episode11.zh/scene_prompt "The faceless Ghost silhouette dissolving back into white heat particles, and at the instant of vanishing a single teal mote of light glows within its outline then fades, ominous and mysterious, cyber neon", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.5} {:db/id -51, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "SHIRO。那里面——青色的，光。", :shotlist.episode11.zh/shiro_emo "surprised", :shotlist.episode11.zh/pico_emo "surprised", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -52, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "……你也看到了？", :shotlist.episode11.zh/shiro_emo "surprised", :shotlist.episode11.zh/pico_emo "normal", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -53, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "信息是物理的。就算消失，必定会留下痕迹。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "normal", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -54, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "把Ghost改写过的命令，全部还原。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "normal", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -55, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "招式，Heat-Memory Restore！", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "whoosh", :shotlist.episode11.zh/fx "flash"} {:db/id -56, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "info_layer", :shotlist.episode11.zh/scene_prompt "Streams of white heat particles flowing into server racks, overwritten commands restoring to original form, teal restore-light spreading across the data layer, cyber neon recovery glow", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.0} {:db/id -57, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "招式，Full-Spectrum Scan——全部捡回来。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash"} {:db/id -58, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "info_layer", :shotlist.episode11.zh/scene_prompt "Plant-wide teal scan light sweeping across the whole facility, every spot the Ghost touched lighting up as white heat afterimages, altered values and fake commands all exposed, cyber neon", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.0} {:db/id -59, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "好嘞！", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "whoosh", :shotlist.episode11.zh/fx nil} {:db/id -60, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "——Double Remanence Reset！", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash"} {:db/id -61, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "——Double Remanence Reset！", :shotlist.episode11.zh/shiro_emo "happy", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash"} {:db/id -62, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "plant_restored", :shotlist.episode11.zh/scene_prompt "Teal and white light merging in a ripple across the whole geothermal plant, red values reverting to normal, pipe pressure easing, steam settling, alarms silenced, triumphant cyber neon dawn", :shotlist.episode11.zh/sfx "ambient", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.5} {:db/id -63, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "geothermal_plant_dawn", :shotlist.episode11.zh/scene_prompt "Exterior plant wall at brightening dawn, two small chibi hero silhouettes sitting side by side on the wall, steam columns flushed with morning light, calm teal sky, quiet aftermath", :shotlist.episode11.zh/sfx "ambient", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 3.0} {:db/id -64, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "……SHIRO。Ghost，好强啊。", :shotlist.episode11.zh/shiro_emo "sad", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -65, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "嗯。", :shotlist.episode11.zh/shiro_emo "sad", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -66, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "……连SHIRO也赢不了吗？", :shotlist.episode11.zh/shiro_emo "sad", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -67, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "Ghost，太会抹除了。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -68, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "但没法完全消除。总有一天，一定能看到。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "normal", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -69, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "那到底是什么呢。那道光。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "thinking", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -70, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "……我也，还不清楚。", :shotlist.episode11.zh/shiro_emo "thinking", :shotlist.episode11.zh/pico_emo "thinking", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -71, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "我以前很擅长删日志。删得不被发现。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -72, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "……可今天，什么都没消失。全都留着。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -73, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "……我做过的事，是不是也都留着呢。", :shotlist.episode11.zh/shiro_emo "sad", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -74, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "走吧，PICO。——去下一座城。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "sad", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -75, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "……既然没消失，那就得去面对啊。", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "thinking", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -76, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "geothermal_plant_dawn", :shotlist.episode11.zh/scene_prompt "Distant plant view in morning light, for one instant white heat-haze forms a faceless humanoid silhouette then vanishes, a single teal mote glowing within its outline before fading, ominous mysterious cyber neon, To be continued", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx "flash", :shotlist.episode11.zh/dur 3.5} {:db/id -77, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "zukan_corner", :shotlist.episode11.zh/scene_prompt "Bright clean whiteboard channel-style corner, friendly studio lighting, a hand cupping glowing white light particles, teal accent graphics, cheerful educational cyber vibe, character-free", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 2.5} {:db/id -78, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "今天的“data remanence”是什么呀！？", :shotlist.episode11.zh/shiro_emo "normal", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "pop", :shotlist.episode11.zh/fx nil} {:db/id -79, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "Data remanence＝数据残留。删了也会留痕。", :shotlist.episode11.zh/shiro_emo "happy", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -80, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "兰道尔原理。擦除一定会产生热。", :shotlist.episode11.zh/shiro_emo "happy", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -81, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "pico", :shotlist.episode11.zh/text "所以就算日志没了，也会被发现？", :shotlist.episode11.zh/shiro_emo "happy", :shotlist.episode11.zh/pico_emo "confused", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -82, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "对。forensics工具会把痕迹挖出来。", :shotlist.episode11.zh/shiro_emo "happy", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx nil, :shotlist.episode11.zh/fx nil} {:db/id -83, :shotlist.episode11.zh/type "dialogue", :shotlist.episode11.zh/speaker "shiro", :shotlist.episode11.zh/text "信息是物理的。就算消失，光也会留下✨", :shotlist.episode11.zh/shiro_emo "happy", :shotlist.episode11.zh/pico_emo "happy", :shotlist.episode11.zh/sfx "chime", :shotlist.episode11.zh/fx "flash"} {:db/id -84, :shotlist.episode11.zh/type "scene", :shotlist.episode11.zh/scene_key "ed_hideandseek", :shotlist.episode11.zh/scene_prompt "Soft teal cyber dusk ED scene, a faceless white heat-haze Ghost silhouette peeking shyly then hiding, within its outline a single teal mote of light stays glowing and does not fade, gentle ominous warmth, neon", :shotlist.episode11.zh/sfx "ghost", :shotlist.episode11.zh/fx nil, :shotlist.episode11.zh/dur 3.0}]