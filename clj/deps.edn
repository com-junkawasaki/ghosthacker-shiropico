{:paths ["src"]

 ;; SHIRO & PICO publish actor (shiropico.*) — StateGraph containment +
 ;; independent PolicyGovernor + append-only ledger (CLAUDE.md "Actors"),
 ;; self-sovereign kotoba-server identity (no owner hand-off). Ported from
 ;; com-etzhayyim-tsumugu's shape (Spirit in Physics' publish actor), adapted
 ;; to animeka's cut domain and built directly on kotoba-lang/comfyui's
 ;; `comfyui.gateway` for rendering (see
 ;; 90-docs/adr/2607011900-genapp-clj-mangaka-animeka-commons.md and
 ;; 90-docs/adr/2607011816-ghosthacker-shiropico-standalone-repo.md).
 ;;
 ;; Lives inside this content repo (not a separate com-etzhayyim-* actor
 ;; repo) — SHIRO & PICO's publish actor stays co-located with the content
 ;; it publishes, same as mangaka/animeka keep their app + data together.
 ;;
 ;; All four in-repo portable libs are kotoba-lang (the com-junkawasaki/*
 ;; originals are mid-migration out per repos.edn's :orgs taxonomy note).
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  io.github.kotoba-lang/langgraph {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
  io.github.kotoba-lang/langchain {:git/sha "c7943d7542f28242a654ff3e0c37100b48a9417d"}
  io.github.kotoba-lang/comfyui   {:git/sha "4ef264754b8531acbf1f44e2015ec9f0f9b04486"}
  ;; JVM application host: compile the confined Kotoba decision module once,
  ;; then execute its checked IR at the operation boundary.
  io.github.kotoba-lang/compiler  {:git/sha "2ba4e08dc39edc28b9f341254a66623f2dc48ea6"}

  ;; shiropico.cacao — kotoba-lang portable crypto (no JCA dependent code):
  ;; Ed25519 sign/verify/did:key, SHA-256, and RFC 4648 base64 + UTF-8 bytes.
  io.github.kotoba-lang/org-ietf-ed25519
  {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
   :git/sha "c0b11c5ffe25d42f29b3f6a3d2d2317331e75336"}
  io.github.kotoba-lang/org-nist-sha2
  {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
   :git/sha "cb67e53e590e0999d741523797729a3d747cda95"}
  io.github.kotoba-lang/bytes
  {:git/url "https://github.com/kotoba-lang/bytes.git"
   :git/sha "acf1e1a3ed9063211e5a94b094b85b72e1917331"}

  ;; comfyui.gateway / langchain.jvm are JVM-only host-fn adapters that
  ;; deliberately don't pull http-kit/jsonista into their own repos' main
  ;; :deps (keeps the pure cores SCI/WASM/CLJS-clean) -- every consumer
  ;; brings its own, same as mangaka/animeka do for their own server needs.
  http-kit/http-kit   {:mvn/version "2.8.0"}
  metosin/jsonista     {:mvn/version "0.3.11"}}

 :aliases
 {;; Workspace development — use the local lib checkouts (no git fetch).
  :dev
  {:override-deps
   {io.github.kotoba-lang/langgraph {:local/root "../../../kotoba-lang/langgraph"}
    io.github.kotoba-lang/langchain {:local/root "../../../kotoba-lang/langchain"}
    io.github.kotoba-lang/comfyui   {:local/root "../../../kotoba-lang/comfyui"}
    io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../../../kotoba-lang/org-ietf-ed25519"}
    io.github.kotoba-lang/org-nist-sha2    {:local/root "../../../kotoba-lang/org-nist-sha2"}
    io.github.kotoba-lang/bytes            {:local/root "../../../kotoba-lang/bytes"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
   :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
