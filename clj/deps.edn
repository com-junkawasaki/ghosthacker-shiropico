{:paths ["src"]

 ;; SHIRO & PICO publish actor (shiropico.*) — StateGraph containment +
 ;; independent PolicyGovernor + append-only ledger (CLAUDE.md "Actors"),
 ;; self-sovereign kotoba-server identity (no owner hand-off). Ported from
 ;; com-etzhayyim-tsumugu's shape (Spirit in Physics' publish actor), adapted
 ;; to animeka's cut domain and built directly on kotoba-lang/genapp-clj for
 ;; rendering (see 90-docs/adr/2607011900-genapp-clj-mangaka-animeka-commons.md
 ;; and 90-docs/adr/2607011816-ghosthacker-shiropico-standalone-repo.md).
 ;;
 ;; Lives inside this content repo (not a separate com-etzhayyim-* actor
 ;; repo) — SHIRO & PICO's publish actor stays co-located with the content
 ;; it publishes, same as mangaka/animeka keep their app + data together.
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  io.github.com-junkawasaki/langgraph-clj {:git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}
  io.github.com-junkawasaki/langchain-clj {:git/tag "v0.1.0" :git/sha "ae475c9"}
  io.github.kotoba-lang/genapp-clj        {:git/sha "69abd6bcc50fd05a3c4e28d9730fc2b30e9cc19a"}}

 :aliases
 {;; Workspace development — use the local lib checkouts (no git fetch).
  :dev
  {:override-deps
   {io.github.com-junkawasaki/langgraph-clj {:local/root "../../../com-junkawasaki/langgraph-clj"}
    io.github.com-junkawasaki/langchain-clj {:local/root "../../../com-junkawasaki/langchain-clj"}
    io.github.kotoba-lang/genapp-clj        {:local/root "../../../kotoba-lang/genapp-clj"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
   :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
