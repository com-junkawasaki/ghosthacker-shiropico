(ns shiropico.publish-decision
  (:export [decide]))

;; Result codes are stable at the host boundary:
;; 0 = hold, 1 = escalate for approval, 2 = commit.
;; Inputs are already validated, bounded application values:
;; effect: 0 noop, 1 render; confidence-milli: 0..1000; high-stakes: 0|1;
;; phase: 0 read-only, 1 assisted, 2 supervised-auto.
(defn decide [effect :i64 confidence-milli :i64 high-stakes :i64 phase :i64] :i64
  (cond
    (= effect 0) 0
    (= phase 0) 0
    (= high-stakes 1) 1
    (< confidence-milli 400) 1
    (= phase 1) 1
    :else 2))
