[
 {:type "scene", :scene_key "earth_from_space", :scene_prompt "Anime wide shot from orbit: night Earth, teal glowing city grids across continents, suddenly washing into corrupted noise-colored static, ominous epic finale mood, no characters", :sfx "ambient", :fx "flash", :dur 3.5}
 {:type "scene", :scene_key "city_total_assault", :scene_prompt "Epic anime cyber city under total assault, traffic lights all dark, automatic doors slamming open and shut, three swirling storms of red gear icons, cyan ghost particles, blue Zzz sleep marks raging over the skyline, character-free", :sfx "alarm", :fx "shake", :dur 3.5}
 {:type "scene", :scene_key "ghost_silhouette_tower", :scene_prompt "Anime menacing shot: faceless cyan ghost silhouette wavering in noise atop a ruined skyscraper, red countdown digits 05 04 03 blinking in the air, dread suspense, generic", :sfx "ghost", :fx "flash", :dur 3.0}
 {:type "dialogue", :speaker "shiro", :text "...Ils bougent tous en même temps. Le Ghost relie les trois.", :shiro_emo "thinking", :pico_emo "surprised", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "pico", :text "Mais aujourd'hui, on en finit avec tout ! ——Laisse-moi faire !", :shiro_emo "normal", :pico_emo "smug", :sfx "pop", :fx nil}
 {:type "dialogue", :speaker "pico", :text "D'abord le Zombie ! Réveil Sauvage !", :shiro_emo "normal", :pico_emo "happy", :sfx "whoosh", :fx "flash"}
 {:type "dialogue", :speaker "pico", :text "Ensuite le Daemon ! Coupe-Racine !", :shiro_emo "normal", :pico_emo "happy", :sfx "whoosh", :fx nil}
 {:type "dialogue", :speaker "pico", :text "J'ai trouvé le Ghost aussi ! Trace-Chaleur !", :shiro_emo "thinking", :pico_emo "smug", :sfx "whoosh", :fx "flash"}
 {:type "scene", :scene_key "city_total_assault", :scene_prompt "Anime chaos: just-woken devices instantly infecting neighbors with sleep, a gear daemon restarting itself with kacon kacon, a heat trail splitting into three branching ghost paths, generic cyber street", :sfx "alarm", :fx "shake", :dur 2.5}
 {:type "dialogue", :speaker "pico", :text "Q-quoi ?! Le Zombie se multiplie encore et le Daemon est revenu ?!", :shiro_emo "normal", :pico_emo "panic", :sfx "alarm", :fx "shake"}
 {:type "dialogue", :speaker "pico", :text "Je n'arrive pas à suivre tout seul ! Ouahhh !", :shiro_emo "thinking", :pico_emo "panic", :sfx "pop", :fx "shake"}
 {:type "dialogue", :speaker "shiro", :text "——Pico. Tu tournes en rond parce que tu portes tout, tout seul.", :shiro_emo "normal", :pico_emo "sad", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "Identifier, protéger, détecter, répondre, restaurer. Qui agit à chaque étape ?", :shiro_emo "thinking", :pico_emo "thinking", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "pico", :text "...On trie, on répartit les rôles et on avance dans l'ordre. Je vois.", :shiro_emo "normal", :pico_emo "normal", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "C'est ça. L'ennemi d'aujourd'hui est énorme. Alors on y va à fond.", :shiro_emo "happy", :pico_emo "happy", :sfx "chime", :fx nil}
 {:type "scene", :scene_key "henshin_bank", :scene_prompt "Anime transformation bank shot: brilliant teal light cocoon of data particles erupting in a cyber city, long shadows stretching, extra-bright climactic finale glow, generic energy burst, no faces", :sfx "chime", :fx "flash", :dur 3.0}
 {:type "dialogue", :speaker "pico", :text "Dis-moi le plan.", :shiro_emo "normal", :pico_emo "normal", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "Dans l'ordre du NIST CSF. D'abord identifier. Voir le but de l'ennemi.", :shiro_emo "thinking", :pico_emo "thinking", :sfx nil, :fx nil}
 {:type "scene", :scene_key "siem_log_field", :scene_prompt "Anime SIEM visualization: thousands of city log streams converging into glowing lines of light suspended in midair, teal data threads forming a defense analysis grid, epic, character-free", :sfx "chime", :fx "flash", :dur 3.0}
 {:type "dialogue", :speaker "shiro", :text "Le Ghost épie tous les journaux. Sa cible, c'est l'information elle-même.", :shiro_emo "surprised", :pico_emo "surprised", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "pico", :text "Alors place à la protection ! On dresse un mur avant qu'elle soit volée !", :shiro_emo "normal", :pico_emo "idea", :sfx "pop", :fx nil}
 {:type "dialogue", :speaker "pico", :text "Chute de Barrière !", :shiro_emo "normal", :pico_emo "angry", :sfx "whoosh", :fx "flash"}
 {:type "scene", :scene_key "barrier_wall", :scene_prompt "Anime epic shot: a teal membrane of light shielding deployed across cyber city streets, cyan ghost tendrils bouncing off the barrier wall, NIST-CSF protect grid glowing, generic", :sfx "whoosh", :fx "shake", :dur 3.0}
 {:type "dialogue", :speaker "shiro", :text "Maintenant, détecter. ——Où sont les racines du Daemon ?", :shiro_emo "thinking", :pico_emo "thinking", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "Le vieux serveur du sous-sol. C'est là, la racine.", :shiro_emo "normal", :pico_emo "surprised", :sfx "chime", :fx nil}
 {:type "scene", :scene_key "underground_daemon", :scene_prompt "Anime cavernous shot: a colossal gear-machine daemon towering to the ceiling of an old underground server room, restarting endlessly kacon kacon, orange root cables sprawling, ominous, character-free", :sfx "alarm", :fx "shake", :dur 3.5}
 {:type "dialogue", :speaker "pico", :text "Il est énorme ! Mais je sais comment faire. Répondre——il suffit de couper les racines.", :shiro_emo "normal", :pico_emo "surprised", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "Je viens avec toi.", :shiro_emo "normal", :pico_emo "happy", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "pico", :text "Shiro, j'ouvre le chemin jusqu'aux racines ! Maintenant !", :shiro_emo "normal", :pico_emo "angry", :sfx "whoosh", :fx "shake"}
 {:type "dialogue", :speaker "shiro", :text "——Coupe-Racine, couche profonde.", :shiro_emo "normal", :pico_emo "thinking", :sfx "whoosh", :fx "flash"}
 {:type "scene", :scene_key "underground_daemon", :scene_prompt "Anime climactic shot: giant daemon gears freezing one by one then going still, orange root cables dimming as the deepest core is touched, teal light spreading in the server cavern, generic", :sfx "chime", :fx "flash", :dur 3.0}
 {:type "dialogue", :speaker "shiro", :text "Les racines sont coupées. Au tour du Zombie. ——C'est l'heure de restaurer, Pico.", :shiro_emo "normal", :pico_emo "normal", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "pico", :text "Je passe en revue toutes les machines, je les isole, puis je les réveille. Compris !", :shiro_emo "happy", :pico_emo "idea", :sfx "pop", :fx nil}
 {:type "dialogue", :speaker "pico", :text "Appel du Sommeil, déploiement total !", :shiro_emo "normal", :pico_emo "happy", :sfx "whoosh", :fx "flash"}
 {:type "scene", :scene_key "city_recover_ripple", :scene_prompt "Anime hopeful shot: teal ripples of light spreading omnidirectionally across cyber city, sleeping device icons waking up and brightening one by one, EDR isolation glow, recovery, character-free", :sfx "chime", :fx "flash", :dur 3.0}
 {:type "dialogue", :speaker "pico", :text "...Je suis un peu meilleur que dans l'épisode 1, hein.", :shiro_emo "happy", :pico_emo "smug", :sfx "chime", :fx nil}
 {:type "scene", :scene_key "ghost_materialize", :scene_prompt "Anime ominous shot: cyan ghost particles condensing and materializing into a faceless wavering form atop the ruined tower, swirling vortex sucking city log-light inward, epic dread, generic", :sfx "ghost", :fx "flash", :dur 3.5}
 {:type "dialogue", :speaker "shiro", :text "...Le voilà. Le Ghost. Sa vraie forme apparaît pour la première fois cette saison.", :shiro_emo "surprised", :pico_emo "surprised", :sfx "ghost", :fx nil}
 {:type "dialogue", :speaker "pico", :text "Il veut emporter tous les journaux !", :shiro_emo "angry", :pico_emo "panic", :sfx "alarm", :fx "shake"}
 {:type "dialogue", :speaker "shiro", :text "L'information est physique. Même effacée, une trace demeure. ——Je la vois déjà.", :shiro_emo "angry", :pico_emo "surprised", :sfx nil, :fx "flash"}
 {:type "scene", :scene_key "ghost_materialize", :scene_prompt "Anime tense shot: faceless ghost form momentarily wavering, its noisy outline briefly resolving toward a human shape, cyan particles trembling against the night skyline, generic", :sfx "ghost", :fx nil, :dur 2.5}
 {:type "dialogue", :speaker "pico", :text "...Shiro, ne panique pas. L'information ne s'enfuit pas, hein ?", :shiro_emo "surprised", :pico_emo "normal", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "——Oui.", :shiro_emo "happy", :pico_emo "happy", :sfx "chime", :fx nil}
 {:type "dialogue", :speaker "pico", :text "Ne sous-estime pas mon doigté. ——Et là, c'est pour nos amis.", :shiro_emo "normal", :pico_emo "smug", :sfx "pop", :fx nil}
 {:type "dialogue", :speaker "shiro", :text "——Trace-Chaleur, analyse complète.", :shiro_emo "normal", :pico_emo "thinking", :sfx "whoosh", :fx "flash"}
 {:type "scene", :scene_key "heat_trace_reveal", :scene_prompt "Anime epic shot: a beam of white light from a fingertip fully illuminating a ghost's heat trail, the faceless cyan outline rising sharply into view glowing teal over a night cityscape, generic", :sfx "whoosh", :fx "flash", :dur 3.0}
 {:type "dialogue", :speaker "pico", :text "Je t'ai trouvé——! Pleine Rupture !", :shiro_emo "normal", :pico_emo "angry", :sfx "whoosh", :fx "shake"}
 {:type "scene", :scene_key "double_heat_break", :scene_prompt "Anime climactic finish: cyan ghost core shattering into scattering particles transforming into white heat light, dramatic dual hero finishing-pose silhouette against the night skyline, brushstroke energy, generic", :sfx "whoosh", :fx "flash", :dur 3.5}
 {:type "dialogue", :speaker "pico", :text "——Double Rupture de Chaleur !", :shiro_emo "happy", :pico_emo "happy", :sfx "chime", :fx "flash"}
 {:type "dialogue", :speaker "shiro", :text "Vous ne savez encore rien—— c'est ce qu'a dit le Ghost.", :shiro_emo "sad", :pico_emo "surprised", :sfx "ghost", :fx nil}
 {:type "dialogue", :speaker "pico", :text "Il s'est enfui ?!", :shiro_emo "surprised", :pico_emo "panic", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "Il n'a pas fui. Il s'est retiré. C'est tout pour aujourd'hui.", :shiro_emo "thinking", :pico_emo "sad", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "On n'a pas pu le vaincre. Mais le Ghost a reculé pour la première fois.", :shiro_emo "normal", :pico_emo "normal", :sfx nil, :fx nil}
 {:type "scene", :scene_key "rooftop_night", :scene_prompt "Anime quiet shot: city lights settling back to peaceful teal, a ruined building rooftop overlooking the calm night skyline, gentle wind, reflective finale mood, character-free", :sfx "ambient", :fx nil, :dur 3.0}
 {:type "dialogue", :speaker "pico", :text "Quand on a réparti les rôles et avancé dans l'ordre, ça a vraiment marché.", :shiro_emo "happy", :pico_emo "happy", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "On construit dans l'ordre, donc ça ne s'effondre pas. C'est ça, la maturité.", :shiro_emo "normal", :pico_emo "thinking", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "Aujourd'hui, pour la première fois—— tu as trouvé le cœur du Ghost avant moi.", :shiro_emo "happy", :pico_emo "surprised", :sfx "chime", :fx nil}
 {:type "dialogue", :speaker "pico", :text "...C'est un peu déloyal. De dire des trucs pareils.", :shiro_emo "smug", :pico_emo "embarrassed", :sfx "pop", :fx nil}
 {:type "dialogue", :speaker "shiro", :text "...Cette voix. Moi, je l'ai entendue. ——C'est une voix que je connais.", :shiro_emo "sad", :pico_emo "surprised", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "pico", :text "...Tu me le diras un jour ?", :shiro_emo "sad", :pico_emo "thinking", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "——Oui. Un jour, c'est promis. Allons-y, Pico.", :shiro_emo "normal", :pico_emo "normal", :sfx "chime", :fx nil}
 {:type "scene", :scene_key "zukan_board", :scene_prompt "Anime educational corner: a clean whiteboard reading NIST CSF with five circles labeled identify protect detect respond recover, bright friendly studio lighting, character-free", :sfx "chime", :fx nil, :dur 3.0}
 {:type "dialogue", :speaker "pico", :text "Au fait, c'est quoi, le NIST CSF d'aujourd'hui ?", :shiro_emo "normal", :pico_emo "confused", :sfx "pop", :fx nil}
 {:type "dialogue", :speaker "shiro", :text "C'est un cadre qui organise la sécurité en cinq étapes.", :shiro_emo "happy", :pico_emo "thinking", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "shiro", :text "Identifier, protéger, détecter, répondre, restaurer. Empile-les et aucune attaque ne passe.", :shiro_emo "normal", :pico_emo "happy", :sfx "chime", :fx nil}
 {:type "dialogue", :speaker "shiro", :text "Détecter avec Splunk ou Sentinel, répondre avec CrowdStrike, couper les racines avec Mandiant.", :shiro_emo "thinking", :pico_emo "surprised", :sfx nil, :fx nil}
 {:type "dialogue", :speaker "pico", :text "Tout était lié—— tout ce que j'ai appris jusqu'ici !", :shiro_emo "happy", :pico_emo "idea", :sfx "pop", :fx "flash"}
 {:type "dialogue", :speaker "shiro", :text "Si tu veux en savoir plus, file sur la chaîne Yukkuri Cyber !", :shiro_emo "happy", :pico_emo "happy", :sfx "chime", :fx nil}
