[{:db/id -1, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "earth_from_space", :shotlist.episode12.es/scene_prompt "Anime wide shot from orbit: night Earth, teal glowing city grids across continents, suddenly washing into corrupted noise-colored static, ominous epic finale mood, no characters", :shotlist.episode12.es/sfx "ambient", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.5} {:db/id -2, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "city_total_assault", :shotlist.episode12.es/scene_prompt "Epic anime cyber city under total assault, traffic lights all dark, automatic doors slamming open and shut, three swirling storms of red gear icons, cyan ghost particles, blue Zzz sleep marks raging over the skyline, character-free", :shotlist.episode12.es/sfx "alarm", :shotlist.episode12.es/fx "shake", :shotlist.episode12.es/dur 3.5} {:db/id -3, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "ghost_silhouette_tower", :shotlist.episode12.es/scene_prompt "Anime menacing shot: faceless cyan ghost silhouette wavering in noise atop a ruined skyscraper, red countdown digits 05 04 03 blinking in the air, dread suspense, generic", :shotlist.episode12.es/sfx "ghost", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.0} {:db/id -4, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "...Se mueven todos a la vez. El Ghost los une a los tres.", :shotlist.episode12.es/shiro_emo "thinking", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -5, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Pero hoy lo terminamos todo! ——¡Déjamelo a mí!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "smug", :shotlist.episode12.es/sfx "pop", :shotlist.episode12.es/fx nil} {:db/id -6, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Primero, el Zombie! ¡Despertar Salvaje!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "flash"} {:db/id -7, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Ahora, el Daemon! ¡Corte de Raíz!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx nil} {:db/id -8, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡También encontré al Ghost! ¡Rastreo de Calor!", :shotlist.episode12.es/shiro_emo "thinking", :shotlist.episode12.es/pico_emo "smug", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "flash"} {:db/id -9, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "city_total_assault", :shotlist.episode12.es/scene_prompt "Anime chaos: just-woken devices instantly infecting neighbors with sleep, a gear daemon restarting itself with kacon kacon, a heat trail splitting into three branching ghost paths, generic cyber street", :shotlist.episode12.es/sfx "alarm", :shotlist.episode12.es/fx "shake", :shotlist.episode12.es/dur 2.5} {:db/id -10, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¿¡Q-qué?! ¡El Zombie se multiplica otra vez y el Daemon revivió!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "panic", :shotlist.episode12.es/sfx "alarm", :shotlist.episode12.es/fx "shake"} {:db/id -11, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡No doy abasto haciéndolo todo solo! ¡Buaaah!", :shotlist.episode12.es/shiro_emo "thinking", :shotlist.episode12.es/pico_emo "panic", :shotlist.episode12.es/sfx "pop", :shotlist.episode12.es/fx "shake"} {:db/id -12, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "——Pico. Giras en falso porque cargas con todo tú solo.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "sad", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -13, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Identificar, proteger, detectar, responder, recuperar. ¿Quién actúa en cada etapa?", :shotlist.episode12.es/shiro_emo "thinking", :shotlist.episode12.es/pico_emo "thinking", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -14, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "...Separar las cosas, repartir los roles y movernos por orden. Ya veo.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "normal", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -15, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Eso es. El enemigo de hoy es enorme. Por eso iremos con todo.", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil} {:db/id -16, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "henshin_bank", :shotlist.episode12.es/scene_prompt "Anime transformation bank shot: brilliant teal light cocoon of data particles erupting in a cyber city, long shadows stretching, extra-bright climactic finale glow, generic energy burst, no faces", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.0} {:db/id -17, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "Dime el plan.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "normal", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -18, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "En el orden del NIST CSF. Primero, identificar. Ver el objetivo del enemigo.", :shotlist.episode12.es/shiro_emo "thinking", :shotlist.episode12.es/pico_emo "thinking", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -19, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "siem_log_field", :shotlist.episode12.es/scene_prompt "Anime SIEM visualization: thousands of city log streams converging into glowing lines of light suspended in midair, teal data threads forming a defense analysis grid, epic, character-free", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.0} {:db/id -20, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "El Ghost espía todos los registros. Su objetivo es la información misma.", :shotlist.episode12.es/shiro_emo "surprised", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -21, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Entonces toca proteger! ¡Levantamos un muro antes de que la roben!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "idea", :shotlist.episode12.es/sfx "pop", :shotlist.episode12.es/fx nil} {:db/id -22, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Caída de Barrera!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "angry", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "flash"} {:db/id -23, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "barrier_wall", :shotlist.episode12.es/scene_prompt "Anime epic shot: a teal membrane of light shielding deployed across cyber city streets, cyan ghost tendrils bouncing off the barrier wall, NIST-CSF protect grid glowing, generic", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "shake", :shotlist.episode12.es/dur 3.0} {:db/id -24, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Ahora, detectar. ——¿Dónde están las raíces del Daemon?", :shotlist.episode12.es/shiro_emo "thinking", :shotlist.episode12.es/pico_emo "thinking", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -25, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "El viejo servidor del subsuelo. Esa es la raíz.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil} {:db/id -26, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "underground_daemon", :shotlist.episode12.es/scene_prompt "Anime cavernous shot: a colossal gear-machine daemon towering to the ceiling of an old underground server room, restarting endlessly kacon kacon, orange root cables sprawling, ominous, character-free", :shotlist.episode12.es/sfx "alarm", :shotlist.episode12.es/fx "shake", :shotlist.episode12.es/dur 3.5} {:db/id -27, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Es enorme! Pero sé cómo va. Responder——basta con cortar las raíces.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -28, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Voy contigo.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -29, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Shiro, abriré el camino hasta las raíces! ¡Ahora!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "angry", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "shake"} {:db/id -30, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "——Corte de Raíz, capa profunda.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "thinking", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "flash"} {:db/id -31, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "underground_daemon", :shotlist.episode12.es/scene_prompt "Anime climactic shot: giant daemon gears freezing one by one then going still, orange root cables dimming as the deepest core is touched, teal light spreading in the server cavern, generic", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.0} {:db/id -32, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Raíces cortadas. Ahora el Zombie. ——Es hora de recuperar, Pico.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "normal", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -33, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "Reviso todas las máquinas, las aíslo y luego las despierto. ¡Entendido!", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "idea", :shotlist.episode12.es/sfx "pop", :shotlist.episode12.es/fx nil} {:db/id -34, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Llamada de Sueño, despliegue total!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "flash"} {:db/id -35, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "city_recover_ripple", :shotlist.episode12.es/scene_prompt "Anime hopeful shot: teal ripples of light spreading omnidirectionally across cyber city, sleeping device icons waking up and brightening one by one, EDR isolation glow, recovery, character-free", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.0} {:db/id -36, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "...Estoy un poquito mejor que en el episodio 1, ¿eh?", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "smug", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil} {:db/id -37, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "ghost_materialize", :shotlist.episode12.es/scene_prompt "Anime ominous shot: cyan ghost particles condensing and materializing into a faceless wavering form atop the ruined tower, swirling vortex sucking city log-light inward, epic dread, generic", :shotlist.episode12.es/sfx "ghost", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.5} {:db/id -38, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "...Ahí viene. El Ghost. Su forma real aparece por primera vez en la temporada.", :shotlist.episode12.es/shiro_emo "surprised", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx "ghost", :shotlist.episode12.es/fx nil} {:db/id -39, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Quiere llevarse todos los registros!", :shotlist.episode12.es/shiro_emo "angry", :shotlist.episode12.es/pico_emo "panic", :shotlist.episode12.es/sfx "alarm", :shotlist.episode12.es/fx "shake"} {:db/id -40, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "La información es física. Aunque desaparezca, queda un rastro. ——Ya lo veo.", :shotlist.episode12.es/shiro_emo "angry", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx "flash"} {:db/id -41, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "ghost_materialize", :shotlist.episode12.es/scene_prompt "Anime tense shot: faceless ghost form momentarily wavering, its noisy outline briefly resolving toward a human shape, cyan particles trembling against the night skyline, generic", :shotlist.episode12.es/sfx "ghost", :shotlist.episode12.es/fx nil, :shotlist.episode12.es/dur 2.5} {:db/id -42, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "...Shiro, tranquila. La información no se escapa, ¿no?", :shotlist.episode12.es/shiro_emo "surprised", :shotlist.episode12.es/pico_emo "normal", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -43, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "——Sí.", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil} {:db/id -44, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "No subestimes mi mano. ——Y ahora es por nuestros amigos.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "smug", :shotlist.episode12.es/sfx "pop", :shotlist.episode12.es/fx nil} {:db/id -45, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "——Rastreo de Calor, análisis completo.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "thinking", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "flash"} {:db/id -46, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "heat_trace_reveal", :shotlist.episode12.es/scene_prompt "Anime epic shot: a beam of white light from a fingertip fully illuminating a ghost's heat trail, the faceless cyan outline rising sharply into view glowing teal over a night cityscape, generic", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.0} {:db/id -47, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Te encontré——! ¡Ruptura Total!", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "angry", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "shake"} {:db/id -48, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "double_heat_break", :shotlist.episode12.es/scene_prompt "Anime climactic finish: cyan ghost core shattering into scattering particles transforming into white heat light, dramatic dual hero finishing-pose silhouette against the night skyline, brushstroke energy, generic", :shotlist.episode12.es/sfx "whoosh", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.5} {:db/id -49, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "——¡Doble Ruptura de Calor!", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx "flash"} {:db/id -50, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Aún no saben nada—— eso dijo el Ghost.", :shotlist.episode12.es/shiro_emo "sad", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx "ghost", :shotlist.episode12.es/fx nil} {:db/id -51, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¿¡Se escapó?!", :shotlist.episode12.es/shiro_emo "surprised", :shotlist.episode12.es/pico_emo "panic", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -52, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "No huyó. Se retiró. Por hoy llegamos hasta aquí.", :shotlist.episode12.es/shiro_emo "thinking", :shotlist.episode12.es/pico_emo "sad", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -53, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "No pudimos vencerlo. Pero el Ghost retrocedió por primera vez.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "normal", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -54, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "rooftop_night", :shotlist.episode12.es/scene_prompt "Anime quiet shot: city lights settling back to peaceful teal, a ruined building rooftop overlooking the calm night skyline, gentle wind, reflective finale mood, character-free", :shotlist.episode12.es/sfx "ambient", :shotlist.episode12.es/fx nil, :shotlist.episode12.es/dur 3.0} {:db/id -55, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "Cuando repartimos los roles y fuimos por orden, de verdad funcionó.", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -56, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Si construyes por orden, no se derrumba. Eso es la madurez.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "thinking", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -57, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Hoy, por primera vez—— encontraste el núcleo del Ghost antes que yo.", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil} {:db/id -58, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "...Qué injusta eres. Diciendo cosas así.", :shotlist.episode12.es/shiro_emo "smug", :shotlist.episode12.es/pico_emo "embarrassed", :shotlist.episode12.es/sfx "pop", :shotlist.episode12.es/fx nil} {:db/id -59, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "...Esa voz. Yo sí la oí. ——Es una voz que conozco.", :shotlist.episode12.es/shiro_emo "sad", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -60, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "...¿Algún día me lo contarás?", :shotlist.episode12.es/shiro_emo "sad", :shotlist.episode12.es/pico_emo "thinking", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -61, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "——Sí. Algún día, sin falta. Vamos, Pico.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "normal", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil} {:db/id -62, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "zukan_board", :shotlist.episode12.es/scene_prompt "Anime educational corner: a clean whiteboard reading NIST CSF with five circles labeled identify protect detect respond recover, bright friendly studio lighting, character-free", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil, :shotlist.episode12.es/dur 3.0} {:db/id -63, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¿Y qué es el NIST CSF de hoy?", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "confused", :shotlist.episode12.es/sfx "pop", :shotlist.episode12.es/fx nil} {:db/id -64, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Es un marco que organiza la seguridad en cinco etapas.", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "thinking", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -65, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Identificar, proteger, detectar, responder, recuperar. Apílalos y ningún ataque pasa.", :shotlist.episode12.es/shiro_emo "normal", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil} {:db/id -66, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Detectas con Splunk o Sentinel, respondes con CrowdStrike y cortas las raíces con Mandiant.", :shotlist.episode12.es/shiro_emo "thinking", :shotlist.episode12.es/pico_emo "surprised", :shotlist.episode12.es/sfx nil, :shotlist.episode12.es/fx nil} {:db/id -67, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "pico", :shotlist.episode12.es/text "¡Todo estaba conectado—— todo lo que he aprendido hasta ahora!", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "idea", :shotlist.episode12.es/sfx "pop", :shotlist.episode12.es/fx "flash"} {:db/id -68, :shotlist.episode12.es/type "dialogue", :shotlist.episode12.es/speaker "shiro", :shotlist.episode12.es/text "Si quieres saber más, ¡vente al canal Yukkuri Cyber!", :shotlist.episode12.es/shiro_emo "happy", :shotlist.episode12.es/pico_emo "happy", :shotlist.episode12.es/sfx "chime", :shotlist.episode12.es/fx nil} {:db/id -69, :shotlist.episode12.es/type "scene", :shotlist.episode12.es/scene_key "ed_ghost_hide", :shotlist.episode12.es/scene_prompt "Anime ED shot: a cute ghost peeking out then hiding shyly, but for one instant its outline resolves into a human shape against a soft teal night background, gentle, generic", :shotlist.episode12.es/sfx "ghost", :shotlist.episode12.es/fx "flash", :shotlist.episode12.es/dur 3.0}]