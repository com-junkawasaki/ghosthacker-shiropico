[{:db/id -1, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "geothermal_plant_dawn", :shotlist.episode11.fr/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.fr/sfx "ambient", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 3.5} {:db/id -2, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "control_room", :shotlist.episode11.fr/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.0} {:db/id -3, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "corridor_shadow", :shotlist.episode11.fr/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 2.5} {:db/id -4, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "...Le voilà.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "normal", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -5, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "plant_fence", :shotlist.episode11.fr/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.fr/sfx "ambient", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 2.5} {:db/id -6, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Attends, SHIRO ! Pourquoi tu pars en courant comme ça ?!", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx "whoosh", :shotlist.episode11.fr/fx nil} {:db/id -7, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "On entre. Il y a quelque chose de bizarre ici.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "confused", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -8, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Bizarre comment ? Les logs étaient tous propres, non ?", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "confused", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -9, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "...Tu crois vraiment ?", :shotlist.episode11.fr/shiro_emo "smug", :shotlist.episode11.fr/pico_emo "confused", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -10, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Bah oui. S'il n'y a rien, il n'y a rien.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -11, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "control_room", :shotlist.episode11.fr/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 2.5} {:db/id -12, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Tu vois ? Je te l'avais dit. Logs tous propres ! Trop facile, je suis un génie.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "smug", :shotlist.episode11.fr/sfx "pop", :shotlist.episode11.fr/fx nil} {:db/id -13, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Quoi ? C'est déjà réglé. On rentre.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -14, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "deep_pipes", :shotlist.episode11.fr/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.fr/sfx "alarm", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 2.5} {:db/id -15, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "...", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "alarm", :shotlist.episode11.fr/fx nil} {:db/id -16, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Hein ?! Pourquoi ?! C'était tout propre !", :shotlist.episode11.fr/shiro_emo "surprised", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx "alarm", :shotlist.episode11.fr/fx "shake"} {:db/id -17, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "control_room", :shotlist.episode11.fr/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.fr/sfx "alarm", :shotlist.episode11.fr/fx "shake", :shotlist.episode11.fr/dur 3.0} {:db/id -18, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Wouah ! Je n'arrive pas à suivre ! Ça a encore disparu !", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx "alarm", :shotlist.episode11.fr/fx "shake"} {:db/id -19, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Comment ça augmente alors que ça n'arrête pas de disparaître ?!", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx "shake"} {:db/id -20, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "PICO. « Disparu »... vraiment ?", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -21, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "C'est vrai ! Les logs...", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -22, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "On les fait juste SEMBLER disparus.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -23, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "L'information est physique. Quand on l'efface, il reste toujours de la chaleur.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -24, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "...Tu vois ? La chaleur blanche est encore là.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx "flash"} {:db/id -25, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "heat_residue", :shotlist.episode11.fr/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.0} {:db/id -26, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "...Ah. La voilà. Là-bas, au loin.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -27, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Même quand tu crois que c'est parti, la lumière reste. On y va.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "normal", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -28, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "henshin_bank", :shotlist.episode11.fr/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.5} {:db/id -29, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "SHIRO-PICO, ON !", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash"} {:db/id -30, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "info_layer", :shotlist.episode11.fr/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.fr/sfx "whoosh", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 3.0} {:db/id -31, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "PICO, suis les traces de chaleur blanche. C'est toi le plus rapide.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -32, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Compte sur moi ! Technique : Heat-Trace Rush !", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "whoosh", :shotlist.episode11.fr/fx "flash"} {:db/id -33, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "info_layer", :shotlist.episode11.fr/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.fr/sfx "whoosh", :shotlist.episode11.fr/fx "shake", :shotlist.episode11.fr/dur 3.0} {:db/id -34, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Ça se relie ! Tout va vers le core server !", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -35, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "C'est ça, l'entrée.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "normal", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -36, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "core_server", :shotlist.episode11.fr/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 3.5} {:db/id -37, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "...C'est quoi, ça ?", :shotlist.episode11.fr/shiro_emo "surprised", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx nil} {:db/id -38, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "—Ghost.", :shotlist.episode11.fr/shiro_emo "surprised", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx "flash"} {:db/id -39, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "ghost_reveal", :shotlist.episode11.fr/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 4.0} {:db/id -40, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "...Il est apparu. Le vrai.", :shotlist.episode11.fr/shiro_emo "surprised", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -41, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "ghost_reveal", :shotlist.episode11.fr/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.fr/sfx "alarm", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.0} {:db/id -42, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "PICO, recule.", :shotlist.episode11.fr/shiro_emo "angry", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -43, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Tout de suite.", :shotlist.episode11.fr/shiro_emo "angry", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx "shake"} {:db/id -44, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "—Visible Thread.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx "whoosh", :shotlist.episode11.fr/fx "flash"} {:db/id -45, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "ghost_reveal", :shotlist.episode11.fr/scene_prompt "Thin teal threads of light extend trying to trace and outline the faceless white-heat Ghost silhouette, the threads strike its edge and snap back repelled, recoil shockwave, ominous cyber neon", :shotlist.episode11.fr/sfx "whoosh", :shotlist.episode11.fr/fx "shake", :shotlist.episode11.fr/dur 3.0} {:db/id -46, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "SHIRO ?!", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx "shake"} {:db/id -47, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "...Il est puissant. La technologie d'aujourd'hui ne peut pas tout révéler.", :shotlist.episode11.fr/shiro_emo "sad", :shotlist.episode11.fr/pico_emo "panic", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -48, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Tu ne le poursuis pas ?!", :shotlist.episode11.fr/shiro_emo "sad", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -49, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "...Je ne peux pas. Pas maintenant.", :shotlist.episode11.fr/shiro_emo "sad", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -50, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "ghost_reveal", :shotlist.episode11.fr/scene_prompt "The faceless Ghost silhouette dissolving back into white heat particles, and at the instant of vanishing a single teal mote of light glows within its outline then fades, ominous and mysterious, cyber neon", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.5} {:db/id -51, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "SHIRO. À l'intérieur... une lumière turquoise.", :shotlist.episode11.fr/shiro_emo "surprised", :shotlist.episode11.fr/pico_emo "surprised", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -52, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "...Toi aussi tu l'as vue ?", :shotlist.episode11.fr/shiro_emo "surprised", :shotlist.episode11.fr/pico_emo "normal", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -53, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "L'information est physique. Même effacée, il reste toujours une trace.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "normal", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -54, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "On va annuler chaque commande que le Ghost a réécrite.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "normal", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -55, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Technique : Heat-Memory Restore !", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "whoosh", :shotlist.episode11.fr/fx "flash"} {:db/id -56, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "info_layer", :shotlist.episode11.fr/scene_prompt "Streams of white heat particles flowing into server racks, overwritten commands restoring to original form, teal restore-light spreading across the data layer, cyber neon recovery glow", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.0} {:db/id -57, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Technique : Full-Spectrum Scan... on récupère tout.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash"} {:db/id -58, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "info_layer", :shotlist.episode11.fr/scene_prompt "Plant-wide teal scan light sweeping across the whole facility, every spot the Ghost touched lighting up as white heat afterimages, altered values and fake commands all exposed, cyber neon", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.0} {:db/id -59, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "C'est parti !", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "whoosh", :shotlist.episode11.fr/fx nil} {:db/id -60, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "—Double Remanence Reset !", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash"} {:db/id -61, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "—Double Remanence Reset !", :shotlist.episode11.fr/shiro_emo "happy", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash"} {:db/id -62, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "plant_restored", :shotlist.episode11.fr/scene_prompt "Teal and white light merging in a ripple across the whole geothermal plant, red values reverting to normal, pipe pressure easing, steam settling, alarms silenced, triumphant cyber neon dawn", :shotlist.episode11.fr/sfx "ambient", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.5} {:db/id -63, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "geothermal_plant_dawn", :shotlist.episode11.fr/scene_prompt "Exterior plant wall at brightening dawn, two small chibi hero silhouettes sitting side by side on the wall, steam columns flushed with morning light, calm teal sky, quiet aftermath", :shotlist.episode11.fr/sfx "ambient", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 3.0} {:db/id -64, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "...SHIRO. Le Ghost était fort, hein.", :shotlist.episode11.fr/shiro_emo "sad", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -65, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Ouais.", :shotlist.episode11.fr/shiro_emo "sad", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -66, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "...Même toi, tu ne peux pas le battre ?", :shotlist.episode11.fr/shiro_emo "sad", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -67, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Le Ghost efface beaucoup trop bien.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -68, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Mais il ne peut pas tout effacer. Un jour, on le verra, c'est sûr.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "normal", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -69, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Je me demande ce que c'était. Cette lumière.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "thinking", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -70, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "...Moi non plus, je ne sais pas encore.", :shotlist.episode11.fr/shiro_emo "thinking", :shotlist.episode11.fr/pico_emo "thinking", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -71, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Avant, j'étais doué pour effacer les logs. Pour qu'on ne remarque rien.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -72, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "...Mais aujourd'hui, rien n'a disparu. Tout est encore là.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -73, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "...Je me demande si ce que j'ai fait est encore là aussi.", :shotlist.episode11.fr/shiro_emo "sad", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -74, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "On y va, PICO. —Vers la prochaine ville.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "sad", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -75, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "...Si ce n'est pas parti, alors je dois y faire face.", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "thinking", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -76, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "geothermal_plant_dawn", :shotlist.episode11.fr/scene_prompt "Distant plant view in morning light, for one instant white heat-haze forms a faceless humanoid silhouette then vanishes, a single teal mote glowing within its outline before fading, ominous mysterious cyber neon, To be continued", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx "flash", :shotlist.episode11.fr/dur 3.5} {:db/id -77, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "zukan_corner", :shotlist.episode11.fr/scene_prompt "Bright clean whiteboard channel-style corner, friendly studio lighting, a hand cupping glowing white light particles, teal accent graphics, cheerful educational cyber vibe, character-free", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 2.5} {:db/id -78, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "C'est quoi, le « data remanence » d'aujourd'hui ?!", :shotlist.episode11.fr/shiro_emo "normal", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "pop", :shotlist.episode11.fr/fx nil} {:db/id -79, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Data remanence = données résiduelles. Même effacées, il reste une trace.", :shotlist.episode11.fr/shiro_emo "happy", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -80, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Le principe de Landauer. Effacer coûte toujours de la chaleur.", :shotlist.episode11.fr/shiro_emo "happy", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -81, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "pico", :shotlist.episode11.fr/text "Donc même si un log disparaît, on se fait prendre ?", :shotlist.episode11.fr/shiro_emo "happy", :shotlist.episode11.fr/pico_emo "confused", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -82, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "Exact. Les outils de forensics ressortent les traces.", :shotlist.episode11.fr/shiro_emo "happy", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx nil, :shotlist.episode11.fr/fx nil} {:db/id -83, :shotlist.episode11.fr/type "dialogue", :shotlist.episode11.fr/speaker "shiro", :shotlist.episode11.fr/text "L'information est physique. Même effacée, la lumière reste.", :shotlist.episode11.fr/shiro_emo "happy", :shotlist.episode11.fr/pico_emo "happy", :shotlist.episode11.fr/sfx "chime", :shotlist.episode11.fr/fx "flash"} {:db/id -84, :shotlist.episode11.fr/type "scene", :shotlist.episode11.fr/scene_key "ed_hideandseek", :shotlist.episode11.fr/scene_prompt "Soft teal cyber dusk ED scene, a faceless white heat-haze Ghost silhouette peeking shyly then hiding, within its outline a single teal mote of light stays glowing and does not fade, gentle ominous warmth, neon", :shotlist.episode11.fr/sfx "ghost", :shotlist.episode11.fr/fx nil, :shotlist.episode11.fr/dur 3.0}]