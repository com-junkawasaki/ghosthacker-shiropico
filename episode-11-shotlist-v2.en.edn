[{:db/id -1, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "geothermal_plant_dawn", :shotlist.episode11.en/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.en/sfx "ambient", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 3.5} {:db/id -2, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "control_room", :shotlist.episode11.en/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.0} {:db/id -3, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "corridor_shadow", :shotlist.episode11.en/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 2.5} {:db/id -4, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "...There it is.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "normal", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -5, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "plant_fence", :shotlist.episode11.en/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.en/sfx "ambient", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 2.5} {:db/id -6, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "Wait up, SHIRO! Why'd you suddenly start running?!", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx "whoosh", :shotlist.episode11.en/fx nil} {:db/id -7, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "We're going inside. Something's off here.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "confused", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -8, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "Off how? The logs were all clean, weren't they?", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "confused", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -9, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "...You really think so?", :shotlist.episode11.en/shiro_emo "smug", :shotlist.episode11.en/pico_emo "confused", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -10, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "Sure I do. If there's nothing, there's nothing.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -11, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "control_room", :shotlist.episode11.en/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 2.5} {:db/id -12, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "See? Told you. Logs are all clean! Easy peasy, I'm a genius.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "smug", :shotlist.episode11.en/sfx "pop", :shotlist.episode11.en/fx nil} {:db/id -13, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "What? It's solved already. Let's head home.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -14, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "deep_pipes", :shotlist.episode11.en/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.en/sfx "alarm", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 2.5} {:db/id -15, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "...", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "alarm", :shotlist.episode11.en/fx nil} {:db/id -16, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "Huh?! Why?! It was all clean!", :shotlist.episode11.en/shiro_emo "surprised", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx "alarm", :shotlist.episode11.en/fx "shake"} {:db/id -17, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "control_room", :shotlist.episode11.en/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.en/sfx "alarm", :shotlist.episode11.en/fx "shake", :shotlist.episode11.en/dur 3.0} {:db/id -18, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "Whoa! I can't keep up! It vanished again!", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx "alarm", :shotlist.episode11.en/fx "shake"} {:db/id -19, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "How's it growing when it keeps disappearing?!", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx "shake"} {:db/id -20, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "PICO. \"Vanished\"—is that really true?", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -21, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "It's true! The logs—", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -22, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "They're only made to LOOK like they vanished.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -23, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Information is physical. Erase it, and heat always stays behind.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -24, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "...See? The white heat is still there.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx "flash"} {:db/id -25, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "heat_residue", :shotlist.episode11.en/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.0} {:db/id -26, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "...Oh. There it is. Way over there.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -27, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Even when you think it's gone, the light remains. Let's go.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "normal", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -28, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "henshin_bank", :shotlist.episode11.en/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.5} {:db/id -29, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "SHIRO-PICO, ON!", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash"} {:db/id -30, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "info_layer", :shotlist.episode11.en/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.en/sfx "whoosh", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 3.0} {:db/id -31, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "PICO, follow the white heat traces. You're the faster one.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -32, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "Leave it to me! Move: Heat-Trace Rush!", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "whoosh", :shotlist.episode11.en/fx "flash"} {:db/id -33, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "info_layer", :shotlist.episode11.en/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.en/sfx "whoosh", :shotlist.episode11.en/fx "shake", :shotlist.episode11.en/dur 3.0} {:db/id -34, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "It's linking up! They're all heading for the core server!", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -35, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "That's the way in.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "normal", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -36, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "core_server", :shotlist.episode11.en/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 3.5} {:db/id -37, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "...What is that?", :shotlist.episode11.en/shiro_emo "surprised", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx nil} {:db/id -38, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "—Ghost.", :shotlist.episode11.en/shiro_emo "surprised", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx "flash"} {:db/id -39, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "ghost_reveal", :shotlist.episode11.en/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 4.0} {:db/id -40, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "...It showed up. The real thing.", :shotlist.episode11.en/shiro_emo "surprised", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -41, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "ghost_reveal", :shotlist.episode11.en/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.en/sfx "alarm", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.0} {:db/id -42, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "PICO, get back.", :shotlist.episode11.en/shiro_emo "angry", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -43, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Right now.", :shotlist.episode11.en/shiro_emo "angry", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx "shake"} {:db/id -44, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "—Visible Thread.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx "whoosh", :shotlist.episode11.en/fx "flash"} {:db/id -45, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "ghost_reveal", :shotlist.episode11.en/scene_prompt "Thin teal threads of light extend trying to trace and outline the faceless white-heat Ghost silhouette, the threads strike its edge and snap back repelled, recoil shockwave, ominous cyber neon", :shotlist.episode11.en/sfx "whoosh", :shotlist.episode11.en/fx "shake", :shotlist.episode11.en/dur 3.0} {:db/id -46, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "SHIRO?!", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx "shake"} {:db/id -47, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "...It's strong. Today's tech can't reveal all of it.", :shotlist.episode11.en/shiro_emo "sad", :shotlist.episode11.en/pico_emo "panic", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -48, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "You're not going after it?!", :shotlist.episode11.en/shiro_emo "sad", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -49, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "...I can't. Not now.", :shotlist.episode11.en/shiro_emo "sad", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -50, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "ghost_reveal", :shotlist.episode11.en/scene_prompt "The faceless Ghost silhouette dissolving back into white heat particles, and at the instant of vanishing a single teal mote of light glows within its outline then fades, ominous and mysterious, cyber neon", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.5} {:db/id -51, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "SHIRO. Inside it—a teal light.", :shotlist.episode11.en/shiro_emo "surprised", :shotlist.episode11.en/pico_emo "surprised", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -52, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "...You saw it too?", :shotlist.episode11.en/shiro_emo "surprised", :shotlist.episode11.en/pico_emo "normal", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -53, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Information is physical. Even erased, a trace always stays behind.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "normal", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -54, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "We'll undo every command the Ghost rewrote.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "normal", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -55, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "Move: Heat-Memory Restore!", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "whoosh", :shotlist.episode11.en/fx "flash"} {:db/id -56, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "info_layer", :shotlist.episode11.en/scene_prompt "Streams of white heat particles flowing into server racks, overwritten commands restoring to original form, teal restore-light spreading across the data layer, cyber neon recovery glow", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.0} {:db/id -57, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Move: Full-Spectrum Scan—catch every bit.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash"} {:db/id -58, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "info_layer", :shotlist.episode11.en/scene_prompt "Plant-wide teal scan light sweeping across the whole facility, every spot the Ghost touched lighting up as white heat afterimages, altered values and fake commands all exposed, cyber neon", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.0} {:db/id -59, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "On it!", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "whoosh", :shotlist.episode11.en/fx nil} {:db/id -60, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "—Double Remanence Reset!", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash"} {:db/id -61, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "—Double Remanence Reset!", :shotlist.episode11.en/shiro_emo "happy", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash"} {:db/id -62, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "plant_restored", :shotlist.episode11.en/scene_prompt "Teal and white light merging in a ripple across the whole geothermal plant, red values reverting to normal, pipe pressure easing, steam settling, alarms silenced, triumphant cyber neon dawn", :shotlist.episode11.en/sfx "ambient", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.5} {:db/id -63, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "geothermal_plant_dawn", :shotlist.episode11.en/scene_prompt "Exterior plant wall at brightening dawn, two small chibi hero silhouettes sitting side by side on the wall, steam columns flushed with morning light, calm teal sky, quiet aftermath", :shotlist.episode11.en/sfx "ambient", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 3.0} {:db/id -64, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "...SHIRO. The Ghost was strong, huh.", :shotlist.episode11.en/shiro_emo "sad", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -65, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Yeah.", :shotlist.episode11.en/shiro_emo "sad", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -66, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "...Even you can't beat it?", :shotlist.episode11.en/shiro_emo "sad", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -67, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "The Ghost is too good at erasing.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -68, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "But it can't erase completely. Someday we'll see it for sure.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "normal", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -69, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "I wonder what that was. That light.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "thinking", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -70, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "...I don't know yet either.", :shotlist.episode11.en/shiro_emo "thinking", :shotlist.episode11.en/pico_emo "thinking", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -71, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "I used to be great at erasing logs. So no one would notice.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -72, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "...But today, nothing's gone. It's all still here.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -73, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "...I wonder if what I did is still here too.", :shotlist.episode11.en/shiro_emo "sad", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -74, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Let's go, PICO. —On to the next town.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "sad", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -75, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "...If it's not gone, then I've gotta face it.", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "thinking", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -76, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "geothermal_plant_dawn", :shotlist.episode11.en/scene_prompt "Distant plant view in morning light, for one instant white heat-haze forms a faceless humanoid silhouette then vanishes, a single teal mote glowing within its outline before fading, ominous mysterious cyber neon, To be continued", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx "flash", :shotlist.episode11.en/dur 3.5} {:db/id -77, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "zukan_corner", :shotlist.episode11.en/scene_prompt "Bright clean whiteboard channel-style corner, friendly studio lighting, a hand cupping glowing white light particles, teal accent graphics, cheerful educational cyber vibe, character-free", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 2.5} {:db/id -78, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "So what's today's \"data remanence\"?!", :shotlist.episode11.en/shiro_emo "normal", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "pop", :shotlist.episode11.en/fx nil} {:db/id -79, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Data remanence = leftover data. Even when erased, a trace stays behind.", :shotlist.episode11.en/shiro_emo "happy", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -80, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Landauer's principle. Erasing always takes heat.", :shotlist.episode11.en/shiro_emo "happy", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -81, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "pico", :shotlist.episode11.en/text "So even if a log's gone, you get caught?", :shotlist.episode11.en/shiro_emo "happy", :shotlist.episode11.en/pico_emo "confused", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -82, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Right. Forensics tools dig the traces back out.", :shotlist.episode11.en/shiro_emo "happy", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx nil, :shotlist.episode11.en/fx nil} {:db/id -83, :shotlist.episode11.en/type "dialogue", :shotlist.episode11.en/speaker "shiro", :shotlist.episode11.en/text "Information is physical. Even erased, the light remains.", :shotlist.episode11.en/shiro_emo "happy", :shotlist.episode11.en/pico_emo "happy", :shotlist.episode11.en/sfx "chime", :shotlist.episode11.en/fx "flash"} {:db/id -84, :shotlist.episode11.en/type "scene", :shotlist.episode11.en/scene_key "ed_hideandseek", :shotlist.episode11.en/scene_prompt "Soft teal cyber dusk ED scene, a faceless white heat-haze Ghost silhouette peeking shyly then hiding, within its outline a single teal mote of light stays glowing and does not fade, gentle ominous warmth, neon", :shotlist.episode11.en/sfx "ghost", :shotlist.episode11.en/fx nil, :shotlist.episode11.en/dur 3.0}]