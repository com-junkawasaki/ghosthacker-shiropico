[{:db/id -1, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "geothermal_plant_dawn", :shotlist.episode11.ta/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.ta/sfx "ambient", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 3.5} {:db/id -2, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "control_room", :shotlist.episode11.ta/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.0} {:db/id -3, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "corridor_shadow", :shotlist.episode11.ta/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 2.5} {:db/id -4, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "…அதோ இருக்கு।", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "normal", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -5, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "plant_fence", :shotlist.episode11.ta/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.ta/sfx "ambient", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 2.5} {:db/id -6, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "நில்லு SHIRO~! திடீர்னு ஏன் ஓடுற!?", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx "whoosh", :shotlist.episode11.ta/fx nil} {:db/id -7, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "உள்ள போவோம். இங்க ஏதோ தப்பா இருக்கு.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "confused", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -8, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "எப்படி தப்பு? logs எல்லாம் clean-ஆ இருந்துச்சே, இல்ல?", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "confused", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -9, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "…உண்மையாவே அப்படி நெனக்கிறயா?", :shotlist.episode11.ta/shiro_emo "smug", :shotlist.episode11.ta/pico_emo "confused", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -10, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "நிச்சயமா. இல்லாதது இல்லதான்.", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -11, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "control_room", :shotlist.episode11.ta/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 2.5} {:db/id -12, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "பாரு~ சொன்னேனில்ல. logs எல்லாம் clean! சுலபம், நான் மேதை.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "smug", :shotlist.episode11.ta/sfx "pop", :shotlist.episode11.ta/fx nil} {:db/id -13, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "என்ன? தீர்ந்துடுச்சே. வீட்டுக்கு போவோம்~", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -14, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "deep_pipes", :shotlist.episode11.ta/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.ta/sfx "alarm", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 2.5} {:db/id -15, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "…", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "alarm", :shotlist.episode11.ta/fx nil} {:db/id -16, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "அடேங்கப்பா!? ஏன்!? இப்பதான் எல்லாம் clean-ஆ இருந்துச்சே!", :shotlist.episode11.ta/shiro_emo "surprised", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx "alarm", :shotlist.episode11.ta/fx "shake"} {:db/id -17, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "control_room", :shotlist.episode11.ta/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.ta/sfx "alarm", :shotlist.episode11.ta/fx "shake", :shotlist.episode11.ta/dur 3.0} {:db/id -18, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "வாவ்! ஓடி பிடிக்க முடியல! மறுபடியும் மறைஞ்சுடுச்சு!", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx "alarm", :shotlist.episode11.ta/fx "shake"} {:db/id -19, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "மறையுதே, ஆனா அதிகரிக்கிறது எப்படி!!", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx "shake"} {:db/id -20, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "PICO. \"மறைஞ்சுது\"—உண்மையாவா?", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -21, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "உண்மைதான்! logs அது—", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -22, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "\"மறைஞ்சாப்போல காட்டப்படுது\" அவ்வளவுதான்.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -23, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "தகவல் என்பது பௌதிகம். அழிச்சா, வெப்பம் கண்டிப்பா மிஞ்சும்.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -24, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "…பாரு. வெள்ளை வெப்பம், இன்னும் மிஞ்சி இருக்கு.", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx "flash"} {:db/id -25, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "heat_residue", :shotlist.episode11.ta/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.0} {:db/id -26, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "…ஆஹா. இருக்கு. அந்த இடத்துல.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -27, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "மறைஞ்சுன்னு நெனச்சாலும், ஒளி மிஞ்சும். போவோம்.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "normal", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -28, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "henshin_bank", :shotlist.episode11.ta/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.5} {:db/id -29, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "SHIRO-PICO, ON!", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash"} {:db/id -30, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "info_layer", :shotlist.episode11.ta/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.ta/sfx "whoosh", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 3.0} {:db/id -31, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "PICO, வெள்ளை வெப்ப தடத்தை தொடர். வேகத்துல நீதான் மேல.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -32, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "என்கிட்ட விடு! நகர்வு, Heat-Trace Rush!", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "whoosh", :shotlist.episode11.ta/fx "flash"} {:db/id -33, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "info_layer", :shotlist.episode11.ta/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.ta/sfx "whoosh", :shotlist.episode11.ta/fx "shake", :shotlist.episode11.ta/dur 3.0} {:db/id -34, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "இணையுது! எல்லாம் core server பக்கம் போகுது!", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -35, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "அதுதான், நுழைவாயில்.", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "normal", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -36, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "core_server", :shotlist.episode11.ta/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 3.5} {:db/id -37, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "…அது, என்ன?", :shotlist.episode11.ta/shiro_emo "surprised", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx nil} {:db/id -38, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "—Ghost.", :shotlist.episode11.ta/shiro_emo "surprised", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx "flash"} {:db/id -39, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "ghost_reveal", :shotlist.episode11.ta/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 4.0} {:db/id -40, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "…வந்துடுச்சு. ஒரிஜினல்.", :shotlist.episode11.ta/shiro_emo "surprised", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -41, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "ghost_reveal", :shotlist.episode11.ta/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.ta/sfx "alarm", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.0} {:db/id -42, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "PICO, தள்ளி நில்.", :shotlist.episode11.ta/shiro_emo "angry", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -43, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "இப்பவே.", :shotlist.episode11.ta/shiro_emo "angry", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx "shake"} {:db/id -44, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "—Visible Thread.", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx "whoosh", :shotlist.episode11.ta/fx "flash"} {:db/id -45, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "ghost_reveal", :shotlist.episode11.ta/scene_prompt "Thin teal threads of light extend trying to trace and outline the faceless white-heat Ghost silhouette, the threads strike its edge and snap back repelled, recoil shockwave, ominous cyber neon", :shotlist.episode11.ta/sfx "whoosh", :shotlist.episode11.ta/fx "shake", :shotlist.episode11.ta/dur 3.0} {:db/id -46, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "SHIRO!?", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx "shake"} {:db/id -47, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "…பலசாலி. இன்னைய தொழில்நுட்பத்துல, முழுசா தெரியல.", :shotlist.episode11.ta/shiro_emo "sad", :shotlist.episode11.ta/pico_emo "panic", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -48, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "துரத்த மாட்டியா!?", :shotlist.episode11.ta/shiro_emo "sad", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -49, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "…முடியாது. இப்போ முடியாது.", :shotlist.episode11.ta/shiro_emo "sad", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -50, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "ghost_reveal", :shotlist.episode11.ta/scene_prompt "The faceless Ghost silhouette dissolving back into white heat particles, and at the instant of vanishing a single teal mote of light glows within its outline then fades, ominous and mysterious, cyber neon", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.5} {:db/id -51, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "SHIRO. அதுக்கு உள்ள—பச்சை-நீல, ஒளி.", :shotlist.episode11.ta/shiro_emo "surprised", :shotlist.episode11.ta/pico_emo "surprised", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -52, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "…நீயும் பார்த்தியா?", :shotlist.episode11.ta/shiro_emo "surprised", :shotlist.episode11.ta/pico_emo "normal", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -53, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "தகவல் என்பது பௌதிகம். மறைஞ்சாலும், தடம் கண்டிப்பா மிஞ்சும்.", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "normal", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -54, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "Ghost மாத்தின command எல்லாத்தையும் மறுபடி சரிசெய்வோம்.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "normal", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -55, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "நகர்வு, Heat-Memory Restore!", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "whoosh", :shotlist.episode11.ta/fx "flash"} {:db/id -56, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "info_layer", :shotlist.episode11.ta/scene_prompt "Streams of white heat particles flowing into server racks, overwritten commands restoring to original form, teal restore-light spreading across the data layer, cyber neon recovery glow", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.0} {:db/id -57, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "நகர்வு, Full-Spectrum Scan—எல்லாத்தையும் எடுப்போம்.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash"} {:db/id -58, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "info_layer", :shotlist.episode11.ta/scene_prompt "Plant-wide teal scan light sweeping across the whole facility, every spot the Ghost touched lighting up as white heat afterimages, altered values and fake commands all exposed, cyber neon", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.0} {:db/id -59, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "சரி!", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "whoosh", :shotlist.episode11.ta/fx nil} {:db/id -60, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "—Double Remanence Reset!", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash"} {:db/id -61, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "—Double Remanence Reset!", :shotlist.episode11.ta/shiro_emo "happy", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash"} {:db/id -62, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "plant_restored", :shotlist.episode11.ta/scene_prompt "Teal and white light merging in a ripple across the whole geothermal plant, red values reverting to normal, pipe pressure easing, steam settling, alarms silenced, triumphant cyber neon dawn", :shotlist.episode11.ta/sfx "ambient", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.5} {:db/id -63, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "geothermal_plant_dawn", :shotlist.episode11.ta/scene_prompt "Exterior plant wall at brightening dawn, two small chibi hero silhouettes sitting side by side on the wall, steam columns flushed with morning light, calm teal sky, quiet aftermath", :shotlist.episode11.ta/sfx "ambient", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 3.0} {:db/id -64, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "…SHIRO. Ghost, பலசாலியா இருந்துச்சு இல்ல.", :shotlist.episode11.ta/shiro_emo "sad", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -65, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "ஆமா.", :shotlist.episode11.ta/shiro_emo "sad", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -66, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "…SHIRO-வாலயும் ஜெயிக்க முடியாதா?", :shotlist.episode11.ta/shiro_emo "sad", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -67, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "Ghost, அழிக்கறதுல ரொம்ப கெட்டிக்காரன்.", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -68, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "ஆனா முழுசா அழியாது. எப்பவாவது கண்டிப்பா தெரியும்.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "normal", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -69, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "அது என்னவா இருக்கும். அந்த ஒளி.", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "thinking", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -70, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "…எனக்கும், இன்னும் தெரியல.", :shotlist.episode11.ta/shiro_emo "thinking", :shotlist.episode11.ta/pico_emo "thinking", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -71, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "முன்னாடி நான் logs அழிக்கறதுல கெட்டி. யாருக்கும் தெரியாம.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -72, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "…ஆனா இன்னைக்கு, ஒண்ணும் மறையல. எல்லாம் மிஞ்சி இருக்கு.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -73, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "…நான் செஞ்சதும், மிஞ்சி இருக்குமோ.", :shotlist.episode11.ta/shiro_emo "sad", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -74, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "போவோம், PICO. —அடுத்த ஊருக்கு.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "sad", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -75, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "…மறையலன்னா, எதிர்கொள்ளணும்தான்.", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "thinking", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -76, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "geothermal_plant_dawn", :shotlist.episode11.ta/scene_prompt "Distant plant view in morning light, for one instant white heat-haze forms a faceless humanoid silhouette then vanishes, a single teal mote glowing within its outline before fading, ominous mysterious cyber neon, To be continued", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx "flash", :shotlist.episode11.ta/dur 3.5} {:db/id -77, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "zukan_corner", :shotlist.episode11.ta/scene_prompt "Bright clean whiteboard channel-style corner, friendly studio lighting, a hand cupping glowing white light particles, teal accent graphics, cheerful educational cyber vibe, character-free", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 2.5} {:db/id -78, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "இன்னைக்கி \"data remanence\" என்னா!?", :shotlist.episode11.ta/shiro_emo "normal", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "pop", :shotlist.episode11.ta/fx nil} {:db/id -79, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "Data remanence＝தரவு எச்சம். அழிச்சாலும் தடம் மிஞ்சும்.", :shotlist.episode11.ta/shiro_emo "happy", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -80, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "லாண்டாயர் தத்துவம். அழிக்க கண்டிப்பா வெப்பம் தேவை.", :shotlist.episode11.ta/shiro_emo "happy", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -81, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "pico", :shotlist.episode11.ta/text "அதனால log மறைஞ்சாலும், மாட்டிக்குவாங்களா?", :shotlist.episode11.ta/shiro_emo "happy", :shotlist.episode11.ta/pico_emo "confused", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -82, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "ஆமா. forensics tools தடங்களை தோண்டி எடுக்கும்.", :shotlist.episode11.ta/shiro_emo "happy", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx nil, :shotlist.episode11.ta/fx nil} {:db/id -83, :shotlist.episode11.ta/type "dialogue", :shotlist.episode11.ta/speaker "shiro", :shotlist.episode11.ta/text "தகவல் என்பது பௌதிகம். மறைஞ்சாலும், ஒளி மிஞ்சும்✨", :shotlist.episode11.ta/shiro_emo "happy", :shotlist.episode11.ta/pico_emo "happy", :shotlist.episode11.ta/sfx "chime", :shotlist.episode11.ta/fx "flash"} {:db/id -84, :shotlist.episode11.ta/type "scene", :shotlist.episode11.ta/scene_key "ed_hideandseek", :shotlist.episode11.ta/scene_prompt "Soft teal cyber dusk ED scene, a faceless white heat-haze Ghost silhouette peeking shyly then hiding, within its outline a single teal mote of light stays glowing and does not fade, gentle ominous warmth, neon", :shotlist.episode11.ta/sfx "ghost", :shotlist.episode11.ta/fx nil, :shotlist.episode11.ta/dur 3.0}]