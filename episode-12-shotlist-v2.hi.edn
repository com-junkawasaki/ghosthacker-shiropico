[{:db/id -1, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "earth_from_space", :shotlist.episode12.hi/scene_prompt "Anime wide shot from orbit: night Earth, teal glowing city grids across continents, suddenly washing into corrupted noise-colored static, ominous epic finale mood, no characters", :shotlist.episode12.hi/sfx "ambient", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.5} {:db/id -2, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "city_total_assault", :shotlist.episode12.hi/scene_prompt "Epic anime cyber city under total assault, traffic lights all dark, automatic doors slamming open and shut, three swirling storms of red gear icons, cyan ghost particles, blue Zzz sleep marks raging over the skyline, character-free", :shotlist.episode12.hi/sfx "alarm", :shotlist.episode12.hi/fx "shake", :shotlist.episode12.hi/dur 3.5} {:db/id -3, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "ghost_silhouette_tower", :shotlist.episode12.hi/scene_prompt "Anime menacing shot: faceless cyan ghost silhouette wavering in noise atop a ruined skyscraper, red countdown digits 05 04 03 blinking in the air, dread suspense, generic", :shotlist.episode12.hi/sfx "ghost", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.0} {:db/id -4, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "...सब एक साथ हरकत कर रहे हैं। Ghost तीनों को जोड़ रहा है।", :shotlist.episode12.hi/shiro_emo "thinking", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -5, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "पर आज सब कुछ खत्म कर देंगे! ——मुझ पर छोड़ दो!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "smug", :shotlist.episode12.hi/sfx "pop", :shotlist.episode12.hi/fx nil} {:db/id -6, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "पहले Zombie! वाइल्ड वेक-अप!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "flash"} {:db/id -7, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "अब Daemon! रूट-कट!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx nil} {:db/id -8, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "Ghost भी मिल गया! हीट-ट्रेस!", :shotlist.episode12.hi/shiro_emo "thinking", :shotlist.episode12.hi/pico_emo "smug", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "flash"} {:db/id -9, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "city_total_assault", :shotlist.episode12.hi/scene_prompt "Anime chaos: just-woken devices instantly infecting neighbors with sleep, a gear daemon restarting itself with kacon kacon, a heat trail splitting into three branching ghost paths, generic cyber street", :shotlist.episode12.hi/sfx "alarm", :shotlist.episode12.hi/fx "shake", :shotlist.episode12.hi/dur 2.5} {:db/id -10, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "क्-क्या?! Zombie फिर से बढ़ रहा है और Daemon भी वापस आ गया?!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "panic", :shotlist.episode12.hi/sfx "alarm", :shotlist.episode12.hi/fx "shake"} {:db/id -11, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "अकेले सब करते हुए संभाल नहीं पा रहा! आआआ!", :shotlist.episode12.hi/shiro_emo "thinking", :shotlist.episode12.hi/pico_emo "panic", :shotlist.episode12.hi/sfx "pop", :shotlist.episode12.hi/fx "shake"} {:db/id -12, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "——पिको। तुम अकेले सब उठा रहे हो, इसलिए मेहनत बेकार जा रही है।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "sad", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -13, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "पहचानो, बचाओ, पकड़ो, जवाब दो, सुधारो। हर चरण में कौन काम करेगा?", :shotlist.episode12.hi/shiro_emo "thinking", :shotlist.episode12.hi/pico_emo "thinking", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -14, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "...छाँटना, भूमिकाएँ बाँटना, और क्रम से चलना। समझ गया।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "normal", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -15, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "हाँ। आज का दुश्मन बड़ा है। इसलिए पूरी ताकत से लड़ेंगे।", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil} {:db/id -16, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "henshin_bank", :shotlist.episode12.hi/scene_prompt "Anime transformation bank shot: brilliant teal light cocoon of data particles erupting in a cyber city, long shadows stretching, extra-bright climactic finale glow, generic energy burst, no faces", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.0} {:db/id -17, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "योजना बताओ।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "normal", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -18, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "NIST CSF के क्रम में। पहले पहचानो। दुश्मन का इरादा देखो।", :shotlist.episode12.hi/shiro_emo "thinking", :shotlist.episode12.hi/pico_emo "thinking", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -19, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "siem_log_field", :shotlist.episode12.hi/scene_prompt "Anime SIEM visualization: thousands of city log streams converging into glowing lines of light suspended in midair, teal data threads forming a defense analysis grid, epic, character-free", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.0} {:db/id -20, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "Ghost सारे logs चुपके से देख रहा है। उसका निशाना है जानकारी ही।", :shotlist.episode12.hi/shiro_emo "surprised", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -21, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "तो अब बचाव! चोरी होने से पहले दीवार खड़ी करते हैं!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "idea", :shotlist.episode12.hi/sfx "pop", :shotlist.episode12.hi/fx nil} {:db/id -22, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "बैरियर फ़ॉल!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "angry", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "flash"} {:db/id -23, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "barrier_wall", :shotlist.episode12.hi/scene_prompt "Anime epic shot: a teal membrane of light shielding deployed across cyber city streets, cyan ghost tendrils bouncing off the barrier wall, NIST-CSF protect grid glowing, generic", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "shake", :shotlist.episode12.hi/dur 3.0} {:db/id -24, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "अब पकड़ना। ——Daemon की जड़ें कहाँ हैं?", :shotlist.episode12.hi/shiro_emo "thinking", :shotlist.episode12.hi/pico_emo "thinking", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -25, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "ज़मीन के नीचे का पुराना सर्वर। जड़ वहीं है।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil} {:db/id -26, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "underground_daemon", :shotlist.episode12.hi/scene_prompt "Anime cavernous shot: a colossal gear-machine daemon towering to the ceiling of an old underground server room, restarting endlessly kacon kacon, orange root cables sprawling, ominous, character-free", :shotlist.episode12.hi/sfx "alarm", :shotlist.episode12.hi/fx "shake", :shotlist.episode12.hi/dur 3.5} {:db/id -27, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "कितना बड़ा! पर मुझे तरीका पता है। जवाब——बस जड़ें काट दो।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -28, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "मैं भी तुम्हारे साथ चलूँगी।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -29, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "शिरो, मैं जड़ों तक रास्ता खोलता हूँ! अभी!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "angry", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "shake"} {:db/id -30, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "——रूट-कट, गहरी परत।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "thinking", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "flash"} {:db/id -31, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "underground_daemon", :shotlist.episode12.hi/scene_prompt "Anime climactic shot: giant daemon gears freezing one by one then going still, orange root cables dimming as the deepest core is touched, teal light spreading in the server cavern, generic", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.0} {:db/id -32, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "जड़ें कट गईं। अब Zombie। ——अब सुधार का समय है, पिको।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "normal", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -33, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "सारी मशीनें देखकर, अलग करके फिर जगाऊँगा। समझ गया!", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "idea", :shotlist.episode12.hi/sfx "pop", :shotlist.episode12.hi/fx nil} {:db/id -34, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "स्लीप कॉल, पूरी तैनाती!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "flash"} {:db/id -35, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "city_recover_ripple", :shotlist.episode12.hi/scene_prompt "Anime hopeful shot: teal ripples of light spreading omnidirectionally across cyber city, sleeping device icons waking up and brightening one by one, EDR isolation glow, recovery, character-free", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.0} {:db/id -36, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "...पहले एपिसोड से थोड़ा बेहतर हो गया हूँ ना, मैं।", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "smug", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil} {:db/id -37, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "ghost_materialize", :shotlist.episode12.hi/scene_prompt "Anime ominous shot: cyan ghost particles condensing and materializing into a faceless wavering form atop the ruined tower, swirling vortex sucking city log-light inward, epic dread, generic", :shotlist.episode12.hi/sfx "ghost", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.5} {:db/id -38, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "...आ गया। Ghost है। इस सीज़न में पहली बार असली रूप सामने आया।", :shotlist.episode12.hi/shiro_emo "surprised", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx "ghost", :shotlist.episode12.hi/fx nil} {:db/id -39, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "यह सारे logs ले जाना चाहता है!", :shotlist.episode12.hi/shiro_emo "angry", :shotlist.episode12.hi/pico_emo "panic", :shotlist.episode12.hi/sfx "alarm", :shotlist.episode12.hi/fx "shake"} {:db/id -40, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "जानकारी भौतिक होती है। मिट भी जाए, तो निशान रह जाता है। ——मुझे दिख रहा है।", :shotlist.episode12.hi/shiro_emo "angry", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx "flash"} {:db/id -41, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "ghost_materialize", :shotlist.episode12.hi/scene_prompt "Anime tense shot: faceless ghost form momentarily wavering, its noisy outline briefly resolving toward a human shape, cyan particles trembling against the night skyline, generic", :shotlist.episode12.hi/sfx "ghost", :shotlist.episode12.hi/fx nil, :shotlist.episode12.hi/dur 2.5} {:db/id -42, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "...शिरो, घबराओ मत। जानकारी भागती नहीं, है ना?", :shotlist.episode12.hi/shiro_emo "surprised", :shotlist.episode12.hi/pico_emo "normal", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -43, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "——हाँ।", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil} {:db/id -44, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "मेरे हाथ की सफ़ाई को कम मत आँको। ——और अब, दोस्तों के लिए।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "smug", :shotlist.episode12.hi/sfx "pop", :shotlist.episode12.hi/fx nil} {:db/id -45, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "——हीट-ट्रेस, पूरा विश्लेषण।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "thinking", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "flash"} {:db/id -46, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "heat_trace_reveal", :shotlist.episode12.hi/scene_prompt "Anime epic shot: a beam of white light from a fingertip fully illuminating a ghost's heat trail, the faceless cyan outline rising sharply into view glowing teal over a night cityscape, generic", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.0} {:db/id -47, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "मिल गया——! फुल ब्रेक!", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "angry", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "shake"} {:db/id -48, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "double_heat_break", :shotlist.episode12.hi/scene_prompt "Anime climactic finish: cyan ghost core shattering into scattering particles transforming into white heat light, dramatic dual hero finishing-pose silhouette against the night skyline, brushstroke energy, generic", :shotlist.episode12.hi/sfx "whoosh", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.5} {:db/id -49, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "——डबल हीट ब्रेक!", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx "flash"} {:db/id -50, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "तुम लोग अभी कुछ नहीं जानते—— Ghost ने ऐसा कहा।", :shotlist.episode12.hi/shiro_emo "sad", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx "ghost", :shotlist.episode12.hi/fx nil} {:db/id -51, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "भाग गया?!", :shotlist.episode12.hi/shiro_emo "surprised", :shotlist.episode12.hi/pico_emo "panic", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -52, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "भागा नहीं। पीछे हटा। आज के लिए बस इतना ही।", :shotlist.episode12.hi/shiro_emo "thinking", :shotlist.episode12.hi/pico_emo "sad", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -53, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "हम हरा नहीं पाए। पर Ghost पहली बार पीछे हटा।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "normal", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -54, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "rooftop_night", :shotlist.episode12.hi/scene_prompt "Anime quiet shot: city lights settling back to peaceful teal, a ruined building rooftop overlooking the calm night skyline, gentle wind, reflective finale mood, character-free", :shotlist.episode12.hi/sfx "ambient", :shotlist.episode12.hi/fx nil, :shotlist.episode12.hi/dur 3.0} {:db/id -55, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "भूमिकाएँ बाँटकर क्रम से चले, तो सच में काम कर गया।", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -56, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "क्रम से बनाते हैं, इसलिए ढहता नहीं। परिपक्वता यही है।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "thinking", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -57, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "आज, पहली बार—— तुमने मुझसे पहले Ghost का केंद्र ढूँढ़ लिया।", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil} {:db/id -58, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "...थोड़ा बेईमानी है। ऐसी बातें कहना।", :shotlist.episode12.hi/shiro_emo "smug", :shotlist.episode12.hi/pico_emo "embarrassed", :shotlist.episode12.hi/sfx "pop", :shotlist.episode12.hi/fx nil} {:db/id -59, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "...वह आवाज़। मुझे सुनाई दे रही थी। ——यह जानी-पहचानी आवाज़ है।", :shotlist.episode12.hi/shiro_emo "sad", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -60, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "...कभी मुझे बताओगी?", :shotlist.episode12.hi/shiro_emo "sad", :shotlist.episode12.hi/pico_emo "thinking", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -61, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "——हाँ। कभी न कभी, ज़रूर। चलो, पिको।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "normal", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil} {:db/id -62, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "zukan_board", :shotlist.episode12.hi/scene_prompt "Anime educational corner: a clean whiteboard reading NIST CSF with five circles labeled identify protect detect respond recover, bright friendly studio lighting, character-free", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil, :shotlist.episode12.hi/dur 3.0} {:db/id -63, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "आज का यह NIST CSF आखिर है क्या?", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "confused", :shotlist.episode12.hi/sfx "pop", :shotlist.episode12.hi/fx nil} {:db/id -64, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "यह सुरक्षा को पाँच चरणों में व्यवस्थित करने वाला ढाँचा है।", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "thinking", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -65, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "पहचानो→बचाओ→पकड़ो→जवाब दो→सुधारो। ढेर लगाओ तो कोई हमला नहीं टिकता।", :shotlist.episode12.hi/shiro_emo "normal", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil} {:db/id -66, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "Splunk या Sentinel से पकड़ो, CrowdStrike से जवाब दो, Mandiant से जड़ें काटो।", :shotlist.episode12.hi/shiro_emo "thinking", :shotlist.episode12.hi/pico_emo "surprised", :shotlist.episode12.hi/sfx nil, :shotlist.episode12.hi/fx nil} {:db/id -67, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "pico", :shotlist.episode12.hi/text "सब कुछ जुड़ा हुआ था—— जो भी मैंने अब तक सीखा!", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "idea", :shotlist.episode12.hi/sfx "pop", :shotlist.episode12.hi/fx "flash"} {:db/id -68, :shotlist.episode12.hi/type "dialogue", :shotlist.episode12.hi/speaker "shiro", :shotlist.episode12.hi/text "और जानना चाहो तो Yukkuri Cyber चैनल पर आओ!", :shotlist.episode12.hi/shiro_emo "happy", :shotlist.episode12.hi/pico_emo "happy", :shotlist.episode12.hi/sfx "chime", :shotlist.episode12.hi/fx nil} {:db/id -69, :shotlist.episode12.hi/type "scene", :shotlist.episode12.hi/scene_key "ed_ghost_hide", :shotlist.episode12.hi/scene_prompt "Anime ED shot: a cute ghost peeking out then hiding shyly, but for one instant its outline resolves into a human shape against a soft teal night background, gentle, generic", :shotlist.episode12.hi/sfx "ghost", :shotlist.episode12.hi/fx "flash", :shotlist.episode12.hi/dur 3.0}]