[{:db/id -1, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "earth_from_space", :shotlist.episode12.de/scene_prompt "Anime wide shot from orbit: night Earth, teal glowing city grids across continents, suddenly washing into corrupted noise-colored static, ominous epic finale mood, no characters", :shotlist.episode12.de/sfx "ambient", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.5} {:db/id -2, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "city_total_assault", :shotlist.episode12.de/scene_prompt "Epic anime cyber city under total assault, traffic lights all dark, automatic doors slamming open and shut, three swirling storms of red gear icons, cyan ghost particles, blue Zzz sleep marks raging over the skyline, character-free", :shotlist.episode12.de/sfx "alarm", :shotlist.episode12.de/fx "shake", :shotlist.episode12.de/dur 3.5} {:db/id -3, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "ghost_silhouette_tower", :shotlist.episode12.de/scene_prompt "Anime menacing shot: faceless cyan ghost silhouette wavering in noise atop a ruined skyscraper, red countdown digits 05 04 03 blinking in the air, dread suspense, generic", :shotlist.episode12.de/sfx "ghost", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.0} {:db/id -4, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "...Sie bewegen sich alle gleichzeitig. Der Ghost bündelt alle drei.", :shotlist.episode12.de/shiro_emo "thinking", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -5, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Aber heute beenden wir alles! ——Überlass das mir!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "smug", :shotlist.episode12.de/sfx "pop", :shotlist.episode12.de/fx nil} {:db/id -6, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Zuerst der Zombie! Wildes Aufwecken!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "flash"} {:db/id -7, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Jetzt der Daemon! Wurzel-Schnitt!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx nil} {:db/id -8, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Den Ghost hab ich auch gefunden! Hitze-Spur!", :shotlist.episode12.de/shiro_emo "thinking", :shotlist.episode12.de/pico_emo "smug", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "flash"} {:db/id -9, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "city_total_assault", :shotlist.episode12.de/scene_prompt "Anime chaos: just-woken devices instantly infecting neighbors with sleep, a gear daemon restarting itself with kacon kacon, a heat trail splitting into three branching ghost paths, generic cyber street", :shotlist.episode12.de/sfx "alarm", :shotlist.episode12.de/fx "shake", :shotlist.episode12.de/dur 2.5} {:db/id -10, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "W-was?! Der Zombie vermehrt sich wieder und der Daemon ist auch zurück?!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "panic", :shotlist.episode12.de/sfx "alarm", :shotlist.episode12.de/fx "shake"} {:db/id -11, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Ganz allein komm ich da nicht hinterher! Wääh!", :shotlist.episode12.de/shiro_emo "thinking", :shotlist.episode12.de/pico_emo "panic", :shotlist.episode12.de/sfx "pop", :shotlist.episode12.de/fx "shake"} {:db/id -12, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "——Pico. Du drehst durch, weil du alles allein trägst.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "sad", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -13, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Identifizieren, schützen, erkennen, reagieren, wiederherstellen. Wer handelt in welcher Phase?", :shotlist.episode12.de/shiro_emo "thinking", :shotlist.episode12.de/pico_emo "thinking", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -14, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "...Aufteilen, die Rollen verteilen und der Reihe nach handeln. Verstehe.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "normal", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -15, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Genau. Der heutige Feind ist riesig. Deshalb geben wir alles.", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil} {:db/id -16, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "henshin_bank", :shotlist.episode12.de/scene_prompt "Anime transformation bank shot: brilliant teal light cocoon of data particles erupting in a cyber city, long shadows stretching, extra-bright climactic finale glow, generic energy burst, no faces", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.0} {:db/id -17, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Sag mir den Plan.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "normal", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -18, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "In der Reihenfolge des NIST CSF. Zuerst identifizieren. Das Ziel des Feindes erkennen.", :shotlist.episode12.de/shiro_emo "thinking", :shotlist.episode12.de/pico_emo "thinking", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -19, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "siem_log_field", :shotlist.episode12.de/scene_prompt "Anime SIEM visualization: thousands of city log streams converging into glowing lines of light suspended in midair, teal data threads forming a defense analysis grid, epic, character-free", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.0} {:db/id -20, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Der Ghost späht alle Logs aus. Sein Ziel ist die Information selbst.", :shotlist.episode12.de/shiro_emo "surprised", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -21, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Dann jetzt schützen! Wir ziehen eine Mauer, bevor es gestohlen wird!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "idea", :shotlist.episode12.de/sfx "pop", :shotlist.episode12.de/fx nil} {:db/id -22, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Barrieren-Fall!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "angry", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "flash"} {:db/id -23, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "barrier_wall", :shotlist.episode12.de/scene_prompt "Anime epic shot: a teal membrane of light shielding deployed across cyber city streets, cyan ghost tendrils bouncing off the barrier wall, NIST-CSF protect grid glowing, generic", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "shake", :shotlist.episode12.de/dur 3.0} {:db/id -24, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Jetzt erkennen. ——Wo sind die Wurzeln des Daemon?", :shotlist.episode12.de/shiro_emo "thinking", :shotlist.episode12.de/pico_emo "thinking", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -25, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Der alte Server im Untergrund. Dort ist die Wurzel.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil} {:db/id -26, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "underground_daemon", :shotlist.episode12.de/scene_prompt "Anime cavernous shot: a colossal gear-machine daemon towering to the ceiling of an old underground server room, restarting endlessly kacon kacon, orange root cables sprawling, ominous, character-free", :shotlist.episode12.de/sfx "alarm", :shotlist.episode12.de/fx "shake", :shotlist.episode12.de/dur 3.5} {:db/id -27, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Riesig! Aber ich weiß, wie's geht. Reagieren——einfach die Wurzeln durchtrennen.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -28, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Ich komme mit.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -29, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Shiro, ich öffne den Weg bis zu den Wurzeln! Jetzt!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "angry", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "shake"} {:db/id -30, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "——Wurzel-Schnitt, tiefe Schicht.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "thinking", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "flash"} {:db/id -31, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "underground_daemon", :shotlist.episode12.de/scene_prompt "Anime climactic shot: giant daemon gears freezing one by one then going still, orange root cables dimming as the deepest core is touched, teal light spreading in the server cavern, generic", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.0} {:db/id -32, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Die Wurzeln sind durchtrennt. Jetzt der Zombie. ——Zeit zum Wiederherstellen, Pico.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "normal", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -33, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Alle Geräte überblicken, isolieren und dann aufwecken. Verstanden!", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "idea", :shotlist.episode12.de/sfx "pop", :shotlist.episode12.de/fx nil} {:db/id -34, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Schlaf-Ruf, volle Entfaltung!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "flash"} {:db/id -35, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "city_recover_ripple", :shotlist.episode12.de/scene_prompt "Anime hopeful shot: teal ripples of light spreading omnidirectionally across cyber city, sleeping device icons waking up and brightening one by one, EDR isolation glow, recovery, character-free", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.0} {:db/id -36, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "...Ich bin ein bisschen besser als in Folge 1, was?", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "smug", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil} {:db/id -37, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "ghost_materialize", :shotlist.episode12.de/scene_prompt "Anime ominous shot: cyan ghost particles condensing and materializing into a faceless wavering form atop the ruined tower, swirling vortex sucking city log-light inward, epic dread, generic", :shotlist.episode12.de/sfx "ghost", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.5} {:db/id -38, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "...Da kommt er. Der Ghost. Seine wahre Gestalt zeigt sich zum ersten Mal in dieser Staffel.", :shotlist.episode12.de/shiro_emo "surprised", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx "ghost", :shotlist.episode12.de/fx nil} {:db/id -39, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Er will alle Logs mitnehmen!", :shotlist.episode12.de/shiro_emo "angry", :shotlist.episode12.de/pico_emo "panic", :shotlist.episode12.de/sfx "alarm", :shotlist.episode12.de/fx "shake"} {:db/id -40, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Information ist physisch. Selbst wenn sie verschwindet, bleibt eine Spur. ——Ich sehe sie schon.", :shotlist.episode12.de/shiro_emo "angry", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx "flash"} {:db/id -41, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "ghost_materialize", :shotlist.episode12.de/scene_prompt "Anime tense shot: faceless ghost form momentarily wavering, its noisy outline briefly resolving toward a human shape, cyan particles trembling against the night skyline, generic", :shotlist.episode12.de/sfx "ghost", :shotlist.episode12.de/fx nil, :shotlist.episode12.de/dur 2.5} {:db/id -42, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "...Shiro, keine Panik. Information läuft nicht weg, oder?", :shotlist.episode12.de/shiro_emo "surprised", :shotlist.episode12.de/pico_emo "normal", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -43, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "——Ja.", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil} {:db/id -44, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Unterschätz mein Händchen nicht. ——Und jetzt ist es für unsere Freunde.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "smug", :shotlist.episode12.de/sfx "pop", :shotlist.episode12.de/fx nil} {:db/id -45, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "——Hitze-Spur, vollständige Analyse.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "thinking", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "flash"} {:db/id -46, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "heat_trace_reveal", :shotlist.episode12.de/scene_prompt "Anime epic shot: a beam of white light from a fingertip fully illuminating a ghost's heat trail, the faceless cyan outline rising sharply into view glowing teal over a night cityscape, generic", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.0} {:db/id -47, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Gefunden——! Voller Bruch!", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "angry", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "shake"} {:db/id -48, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "double_heat_break", :shotlist.episode12.de/scene_prompt "Anime climactic finish: cyan ghost core shattering into scattering particles transforming into white heat light, dramatic dual hero finishing-pose silhouette against the night skyline, brushstroke energy, generic", :shotlist.episode12.de/sfx "whoosh", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.5} {:db/id -49, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "——Doppelter Hitze-Bruch!", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx "flash"} {:db/id -50, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Ihr wisst noch gar nichts—— das hat der Ghost gesagt.", :shotlist.episode12.de/shiro_emo "sad", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx "ghost", :shotlist.episode12.de/fx nil} {:db/id -51, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Er ist entkommen?!", :shotlist.episode12.de/shiro_emo "surprised", :shotlist.episode12.de/pico_emo "panic", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -52, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Er ist nicht geflohen. Er hat sich zurückgezogen. Für heute reicht's.", :shotlist.episode12.de/shiro_emo "thinking", :shotlist.episode12.de/pico_emo "sad", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -53, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Wir konnten ihn nicht besiegen. Aber der Ghost ist zum ersten Mal zurückgewichen.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "normal", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -54, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "rooftop_night", :shotlist.episode12.de/scene_prompt "Anime quiet shot: city lights settling back to peaceful teal, a ruined building rooftop overlooking the calm night skyline, gentle wind, reflective finale mood, character-free", :shotlist.episode12.de/sfx "ambient", :shotlist.episode12.de/fx nil, :shotlist.episode12.de/dur 3.0} {:db/id -55, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Als wir die Rollen aufgeteilt und der Reihe nach gehandelt haben, hat's wirklich geklappt.", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -56, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Wir bauen der Reihe nach auf, deshalb stürzt es nicht ein. Das ist Reife.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "thinking", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -57, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Heute, zum ersten Mal—— hast du den Kern des Ghost vor mir gefunden.", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil} {:db/id -58, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "...Das ist irgendwie unfair. So was zu sagen.", :shotlist.episode12.de/shiro_emo "smug", :shotlist.episode12.de/pico_emo "embarrassed", :shotlist.episode12.de/sfx "pop", :shotlist.episode12.de/fx nil} {:db/id -59, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "...Diese Stimme. Ich konnte sie hören. ——Es ist eine Stimme, die ich kenne.", :shotlist.episode12.de/shiro_emo "sad", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -60, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "...Erzählst du es mir irgendwann?", :shotlist.episode12.de/shiro_emo "sad", :shotlist.episode12.de/pico_emo "thinking", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -61, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "——Ja. Irgendwann, ganz bestimmt. Gehen wir, Pico.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "normal", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil} {:db/id -62, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "zukan_board", :shotlist.episode12.de/scene_prompt "Anime educational corner: a clean whiteboard reading NIST CSF with five circles labeled identify protect detect respond recover, bright friendly studio lighting, character-free", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil, :shotlist.episode12.de/dur 3.0} {:db/id -63, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Und was ist das heutige NIST CSF eigentlich?", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "confused", :shotlist.episode12.de/sfx "pop", :shotlist.episode12.de/fx nil} {:db/id -64, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Ein Rahmenwerk, das Sicherheit in fünf Phasen ordnet.", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "thinking", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -65, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Identifizieren, schützen, erkennen, reagieren, wiederherstellen. Stapelt man sie, hält jeder Angriff stand.", :shotlist.episode12.de/shiro_emo "normal", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil} {:db/id -66, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Mit Splunk oder Sentinel erkennen, mit CrowdStrike reagieren, mit Mandiant die Wurzeln kappen.", :shotlist.episode12.de/shiro_emo "thinking", :shotlist.episode12.de/pico_emo "surprised", :shotlist.episode12.de/sfx nil, :shotlist.episode12.de/fx nil} {:db/id -67, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "pico", :shotlist.episode12.de/text "Es hing alles zusammen—— alles, was ich bisher gelernt habe!", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "idea", :shotlist.episode12.de/sfx "pop", :shotlist.episode12.de/fx "flash"} {:db/id -68, :shotlist.episode12.de/type "dialogue", :shotlist.episode12.de/speaker "shiro", :shotlist.episode12.de/text "Wer mehr wissen will, ab zum Yukkuri-Cyber-Kanal!", :shotlist.episode12.de/shiro_emo "happy", :shotlist.episode12.de/pico_emo "happy", :shotlist.episode12.de/sfx "chime", :shotlist.episode12.de/fx nil} {:db/id -69, :shotlist.episode12.de/type "scene", :shotlist.episode12.de/scene_key "ed_ghost_hide", :shotlist.episode12.de/scene_prompt "Anime ED shot: a cute ghost peeking out then hiding shyly, but for one instant its outline resolves into a human shape against a soft teal night background, gentle, generic", :shotlist.episode12.de/sfx "ghost", :shotlist.episode12.de/fx "flash", :shotlist.episode12.de/dur 3.0}]