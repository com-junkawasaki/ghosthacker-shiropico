[{:db/id -1, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "geothermal_plant_dawn", :shotlist.episode11.bn/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.bn/sfx "ambient", :shotlist.episode11.bn/fx nil, :shotlist.episode11.bn/dur 3.5} {:db/id -2, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "control_room", :shotlist.episode11.bn/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.bn/sfx "chime", :shotlist.episode11.bn/fx "flash", :shotlist.episode11.bn/dur 3.0} {:db/id -3, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "corridor_shadow", :shotlist.episode11.bn/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.bn/sfx "ghost", :shotlist.episode11.bn/fx "flash", :shotlist.episode11.bn/dur 2.5} {:db/id -4, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "…ওইতো।", :shotlist.episode11.bn/shiro_emo "thinking", :shotlist.episode11.bn/pico_emo "normal", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -5, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "plant_fence", :shotlist.episode11.bn/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.bn/sfx "ambient", :shotlist.episode11.bn/fx nil, :shotlist.episode11.bn/dur 2.5} {:db/id -6, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "দাঁড়াও না SHIRO~! হঠাৎ দৌড় দিলে কেন!?", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "panic", :shotlist.episode11.bn/sfx "whoosh", :shotlist.episode11.bn/fx nil} {:db/id -7, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "ভেতরে যাব। এখানে কিছু একটা গড়বড়।", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "confused", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -8, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "গড়বড় কীসে? logs তো সব পরিষ্কার ছিল, না?", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "confused", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -9, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "…সত্যিই তাই মনে হয়?", :shotlist.episode11.bn/shiro_emo "smug", :shotlist.episode11.bn/pico_emo "confused", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -10, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "অবশ্যই। যা নেই, তা নেই-ই।", :shotlist.episode11.bn/shiro_emo "thinking", :shotlist.episode11.bn/pico_emo "happy", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -11, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "control_room", :shotlist.episode11.bn/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.bn/sfx "chime", :shotlist.episode11.bn/fx nil, :shotlist.episode11.bn/dur 2.5} {:db/id -12, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "দেখলে~ বলেছিলাম তো। logs সব পরিষ্কার! সহজ ব্যাপার, আমি জিনিয়াস।", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "smug", :shotlist.episode11.bn/sfx "pop", :shotlist.episode11.bn/fx nil} {:db/id -13, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "কী? সমাধান তো হয়েই গেল। চলো বাড়ি যাই~", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "happy", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -14, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "deep_pipes", :shotlist.episode11.bn/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.bn/sfx "alarm", :shotlist.episode11.bn/fx nil, :shotlist.episode11.bn/dur 2.5} {:db/id -15, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "…", :shotlist.episode11.bn/shiro_emo "thinking", :shotlist.episode11.bn/pico_emo "happy", :shotlist.episode11.bn/sfx "alarm", :shotlist.episode11.bn/fx nil} {:db/id -16, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "অ্যাঁ!? কেন!? এইমাত্রই তো সব পরিষ্কার ছিল!", :shotlist.episode11.bn/shiro_emo "surprised", :shotlist.episode11.bn/pico_emo "panic", :shotlist.episode11.bn/sfx "alarm", :shotlist.episode11.bn/fx "shake"} {:db/id -17, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "control_room", :shotlist.episode11.bn/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.bn/sfx "alarm", :shotlist.episode11.bn/fx "shake", :shotlist.episode11.bn/dur 3.0} {:db/id -18, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "ওরে বাবা! সামলাতে পারছি না! আবার গায়েব!", :shotlist.episode11.bn/shiro_emo "thinking", :shotlist.episode11.bn/pico_emo "panic", :shotlist.episode11.bn/sfx "alarm", :shotlist.episode11.bn/fx "shake"} {:db/id -19, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "গায়েব হচ্ছে অথচ বাড়ছে কী করে!!", :shotlist.episode11.bn/shiro_emo "thinking", :shotlist.episode11.bn/pico_emo "panic", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx "shake"} {:db/id -20, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "PICO। \"গায়েব\"—সত্যিই কি?", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "panic", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -21, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "সত্যিই! logs তো—", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "panic", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -22, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "শুধু \"গায়েব হয়েছে দেখানো\" হচ্ছে।", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "surprised", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -23, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "তথ্য ভৌত। মুছলে, তাপ সবসময় থেকে যায়।", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "surprised", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -24, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "…দেখো। সাদা তাপ, এখনও রয়ে গেছে।", :shotlist.episode11.bn/shiro_emo "thinking", :shotlist.episode11.bn/pico_emo "surprised", :shotlist.episode11.bn/sfx "ghost", :shotlist.episode11.bn/fx "flash"} {:db/id -25, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "heat_residue", :shotlist.episode11.bn/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.bn/sfx "ghost", :shotlist.episode11.bn/fx "flash", :shotlist.episode11.bn/dur 3.0} {:db/id -26, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "…আরে। পেয়েছি। ওইখানে ওইটায়।", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "surprised", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -27, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "গায়েব হয়েছে ভাবলেও, আলো থেকে যায়। চলো।", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "normal", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -28, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "henshin_bank", :shotlist.episode11.bn/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.bn/sfx "chime", :shotlist.episode11.bn/fx "flash", :shotlist.episode11.bn/dur 3.5} {:db/id -29, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "SHIRO-PICO, ON!", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "happy", :shotlist.episode11.bn/sfx "chime", :shotlist.episode11.bn/fx "flash"} {:db/id -30, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "info_layer", :shotlist.episode11.bn/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.bn/sfx "whoosh", :shotlist.episode11.bn/fx nil, :shotlist.episode11.bn/dur 3.0} {:db/id -31, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "PICO, সাদা তাপের চিহ্ন অনুসরণ করো। গতিতে তুমি এগিয়ে।", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "happy", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -32, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "আমার উপর ছেড়ে দাও! কৌশল, Heat-Trace Rush!", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "happy", :shotlist.episode11.bn/sfx "whoosh", :shotlist.episode11.bn/fx "flash"} {:db/id -33, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "info_layer", :shotlist.episode11.bn/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.bn/sfx "whoosh", :shotlist.episode11.bn/fx "shake", :shotlist.episode11.bn/dur 3.0} {:db/id -34, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "জুড়ে যাচ্ছে! সব core server-এর দিকে যাচ্ছে!", :shotlist.episode11.bn/shiro_emo "normal", :shotlist.episode11.bn/pico_emo "surprised", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -35, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "ওখানেই, প্রবেশপথ।", :shotlist.episode11.bn/shiro_emo "thinking", :shotlist.episode11.bn/pico_emo "normal", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -36, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "core_server", :shotlist.episode11.bn/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.bn/sfx "ghost", :shotlist.episode11.bn/fx nil, :shotlist.episode11.bn/dur 3.5} {:db/id -37, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "…ওটা, কী?", :shotlist.episode11.bn/shiro_emo "surprised", :shotlist.episode11.bn/pico_emo "surprised", :shotlist.episode11.bn/sfx "ghost", :shotlist.episode11.bn/fx nil} {:db/id -38, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "shiro", :shotlist.episode11.bn/text "—Ghost।", :shotlist.episode11.bn/shiro_emo "surprised", :shotlist.episode11.bn/pico_emo "surprised", :shotlist.episode11.bn/sfx "ghost", :shotlist.episode11.bn/fx "flash"} {:db/id -39, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "ghost_reveal", :shotlist.episode11.bn/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.bn/sfx "ghost", :shotlist.episode11.bn/fx "flash", :shotlist.episode11.bn/dur 4.0} {:db/id -40, :shotlist.episode11.bn/type "dialogue", :shotlist.episode11.bn/speaker "pico", :shotlist.episode11.bn/text "…বেরিয়ে এল। আসলটা।", :shotlist.episode11.bn/shiro_emo "surprised", :shotlist.episode11.bn/pico_emo "panic", :shotlist.episode11.bn/sfx nil, :shotlist.episode11.bn/fx nil} {:db/id -41, :shotlist.episode11.bn/type "scene", :shotlist.episode11.bn/scene_key "ghost_reveal", :shotlist.episode11.bn/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.bn/sfx "