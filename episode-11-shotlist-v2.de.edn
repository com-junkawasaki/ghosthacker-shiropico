[{:db/id -1, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "geothermal_plant_dawn", :shotlist.episode11.de/scene_prompt "Aerial wide shot of a massive geothermal power plant on a black lava plateau at near-arctic dawn, pale sky, quiet steam columns rising, cyber neon teal data lines faintly overlaying the pipework, ominous calm", :shotlist.episode11.de/sfx "ambient", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 3.5} {:db/id -2, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "control_room", :shotlist.episode11.de/scene_prompt "Dim power plant control room, wall of monitors glowing teal and amber, night shift, coffee cups, a single white heat-residue afterimage flickering at a screen edge then vanishing like noise", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.0} {:db/id -3, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "corridor_shadow", :shotlist.episode11.de/scene_prompt "Dark plant corridor, a faceless human silhouette made of white heat-haze briefly appears on the wall then dissolves into digital noise, cyber neon, ominous", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 2.5} {:db/id -4, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "...Da ist es.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "normal", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -5, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "plant_fence", :shotlist.episode11.de/scene_prompt "Exterior chain-link fence before the glowing geothermal plant at dawn, teal data motes drifting in cold air, steam behind, cyber neon dusk light", :shotlist.episode11.de/sfx "ambient", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 2.5} {:db/id -6, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Warte, SHIRO! Warum rennst du plötzlich los?!", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx "whoosh", :shotlist.episode11.de/fx nil} {:db/id -7, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Wir gehen rein. Hier stimmt was nicht.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "confused", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -8, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Was denn? Die Logs waren doch alle sauber, oder?", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "confused", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -9, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "...Glaubst du das wirklich?", :shotlist.episode11.de/shiro_emo "smug", :shotlist.episode11.de/pico_emo "confused", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -10, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Klar. Wo nichts ist, ist nichts.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -11, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "control_room", :shotlist.episode11.de/scene_prompt "Anteroom of the control room, holographic log panel summoned from a wall terminal, rows of green OK entries, all clean, teal cyber glow, calm before trouble", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 2.5} {:db/id -12, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Siehst du? Hab ich doch gesagt. Logs alle sauber! Kinderleicht, ich bin ein Genie.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "smug", :shotlist.episode11.de/sfx "pop", :shotlist.episode11.de/fx nil} {:db/id -13, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Was? Schon gelöst. Lass uns heimgehen.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -14, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "deep_pipes", :shotlist.episode11.de/scene_prompt "Deep inside the plant, dense steel pipework and a temperature sensor readout ticking up by a fraction, faint white heat-haze creeping along a valve, ominous cyber neon", :shotlist.episode11.de/sfx "alarm", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 2.5} {:db/id -15, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "...", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "alarm", :shotlist.episode11.de/fx nil} {:db/id -16, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Häh?! Warum?! Es war doch alles sauber!", :shotlist.episode11.de/shiro_emo "surprised", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx "alarm", :shotlist.episode11.de/fx "shake"} {:db/id -17, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "control_room", :shotlist.episode11.de/scene_prompt "Control room monitors flooding red one by one, numeric values rewriting themselves, logs overwriting and vanishing, alarm strobe, chaotic cyber neon, ominous", :shotlist.episode11.de/sfx "alarm", :shotlist.episode11.de/fx "shake", :shotlist.episode11.de/dur 3.0} {:db/id -18, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Wahh! Ich komm nicht hinterher! Schon wieder weg!", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx "alarm", :shotlist.episode11.de/fx "shake"} {:db/id -19, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Wieso wird's mehr, wenn's dauernd verschwindet?!", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx "shake"} {:db/id -20, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "PICO. \"Verschwunden\" – stimmt das wirklich?", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -21, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Echt jetzt! Die Logs—", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -22, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Es wird nur so GEMACHT, als wären sie verschwunden.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -23, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Information ist physisch. Beim Löschen bleibt immer Wärme zurück.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -24, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "...Siehst du? Die weiße Wärme ist noch da.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx "flash"} {:db/id -25, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "heat_residue", :shotlist.episode11.de/scene_prompt "Close cyber view of a wall corner where faint white heat-haze residue drifts at every spot a log was erased, glowing teal traces marking deletions, eerie data remanence, neon", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.0} {:db/id -26, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "...Ah. Da ist es. Da hinten.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -27, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Auch wenn du denkst, es ist weg – das Licht bleibt. Los geht's.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "normal", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -28, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "henshin_bank", :shotlist.episode11.de/scene_prompt "Transformation bank: a teal cocoon of light envelops two figures, data particles swirling, the cocoon bursts into radiant teal bloom, dynamic hero pose silhouettes, cyber neon spectacle", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.5} {:db/id -29, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "SHIRO-PICO, ON!", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash"} {:db/id -30, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "info_layer", :shotlist.episode11.de/scene_prompt "Information-space layer overlaid on plant corridors, data flows glowing as light lines over pipes and walls, teal streams, white heat-trace dots forming a path, cyber neon depth", :shotlist.episode11.de/sfx "whoosh", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 3.0} {:db/id -31, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "PICO, folg den weißen Wärmespuren. Du bist der Schnellere.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -32, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Überlass das mir! Technik: Heat-Trace Rush!", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "whoosh", :shotlist.episode11.de/fx "flash"} {:db/id -33, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "info_layer", :shotlist.episode11.de/scene_prompt "High-speed dash through information space, white heat-trace points connecting dot to line to plane, an erased log shape reconstructing in reverse, motion-blur teal light streaks, cyber neon", :shotlist.episode11.de/sfx "whoosh", :shotlist.episode11.de/fx "shake", :shotlist.episode11.de/dur 3.0} {:db/id -34, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Es verbindet sich! Alles führt zum core server!", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -35, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Da ist der Eingang.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "normal", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -36, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "core_server", :shotlist.episode11.de/scene_prompt "Dim core server room, rows of server racks, at the center a slow swirl of white heat-haze coalescing, ominous cyber neon, teal data motes, dread", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 3.5} {:db/id -37, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "...Was ist das?", :shotlist.episode11.de/shiro_emo "surprised", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx nil} {:db/id -38, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "—Ghost.", :shotlist.episode11.de/shiro_emo "surprised", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx "flash"} {:db/id -39, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "ghost_reveal", :shotlist.episode11.de/scene_prompt "The Ghost's full silhouette revealed: a faceless humanoid figure formed of shimmering white heat-noise particles holding human shape, no face, blurred outline, towering and ominous, cyber neon teal backlight, server racks behind", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 4.0} {:db/id -40, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "...Er ist da. Der echte.", :shotlist.episode11.de/shiro_emo "surprised", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -41, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "ghost_reveal", :shotlist.episode11.de/scene_prompt "The faceless white-heat Ghost slowly raises one arm; every monitor in the core room flares to blank white at once, all logs erasing, blinding flash, ominous cyber neon", :shotlist.episode11.de/sfx "alarm", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.0} {:db/id -42, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "PICO, geh auf Abstand.", :shotlist.episode11.de/shiro_emo "angry", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -43, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Sofort.", :shotlist.episode11.de/shiro_emo "angry", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx "shake"} {:db/id -44, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "—Visible Thread.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx "whoosh", :shotlist.episode11.de/fx "flash"} {:db/id -45, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "ghost_reveal", :shotlist.episode11.de/scene_prompt "Thin teal threads of light extend trying to trace and outline the faceless white-heat Ghost silhouette, the threads strike its edge and snap back repelled, recoil shockwave, ominous cyber neon", :shotlist.episode11.de/sfx "whoosh", :shotlist.episode11.de/fx "shake", :shotlist.episode11.de/dur 3.0} {:db/id -46, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "SHIRO?!", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx "shake"} {:db/id -47, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "...Er ist stark. Die Technik von heute kann nicht alles sichtbar machen.", :shotlist.episode11.de/shiro_emo "sad", :shotlist.episode11.de/pico_emo "panic", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -48, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Du verfolgst ihn nicht?!", :shotlist.episode11.de/shiro_emo "sad", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -49, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "...Ich kann nicht. Jetzt nicht.", :shotlist.episode11.de/shiro_emo "sad", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -50, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "ghost_reveal", :shotlist.episode11.de/scene_prompt "The faceless Ghost silhouette dissolving back into white heat particles, and at the instant of vanishing a single teal mote of light glows within its outline then fades, ominous and mysterious, cyber neon", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.5} {:db/id -51, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "SHIRO. In ihm drin... ein türkises Licht.", :shotlist.episode11.de/shiro_emo "surprised", :shotlist.episode11.de/pico_emo "surprised", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -52, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "...Hast du's auch gesehen?", :shotlist.episode11.de/shiro_emo "surprised", :shotlist.episode11.de/pico_emo "normal", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -53, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Information ist physisch. Auch gelöscht bleibt immer eine Spur zurück.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "normal", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -54, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Wir machen jeden Befehl rückgängig, den der Ghost umgeschrieben hat.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "normal", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -55, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Technik: Heat-Memory Restore!", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "whoosh", :shotlist.episode11.de/fx "flash"} {:db/id -56, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "info_layer", :shotlist.episode11.de/scene_prompt "Streams of white heat particles flowing into server racks, overwritten commands restoring to original form, teal restore-light spreading across the data layer, cyber neon recovery glow", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.0} {:db/id -57, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Technik: Full-Spectrum Scan – wir holen alles raus.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash"} {:db/id -58, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "info_layer", :shotlist.episode11.de/scene_prompt "Plant-wide teal scan light sweeping across the whole facility, every spot the Ghost touched lighting up as white heat afterimages, altered values and fake commands all exposed, cyber neon", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.0} {:db/id -59, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Geht klar!", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "whoosh", :shotlist.episode11.de/fx nil} {:db/id -60, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "—Double Remanence Reset!", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash"} {:db/id -61, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "—Double Remanence Reset!", :shotlist.episode11.de/shiro_emo "happy", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash"} {:db/id -62, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "plant_restored", :shotlist.episode11.de/scene_prompt "Teal and white light merging in a ripple across the whole geothermal plant, red values reverting to normal, pipe pressure easing, steam settling, alarms silenced, triumphant cyber neon dawn", :shotlist.episode11.de/sfx "ambient", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.5} {:db/id -63, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "geothermal_plant_dawn", :shotlist.episode11.de/scene_prompt "Exterior plant wall at brightening dawn, two small chibi hero silhouettes sitting side by side on the wall, steam columns flushed with morning light, calm teal sky, quiet aftermath", :shotlist.episode11.de/sfx "ambient", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 3.0} {:db/id -64, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "...SHIRO. Der Ghost war stark, was.", :shotlist.episode11.de/shiro_emo "sad", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -65, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Ja.", :shotlist.episode11.de/shiro_emo "sad", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -66, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "...Selbst du kannst ihn nicht besiegen?", :shotlist.episode11.de/shiro_emo "sad", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -67, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Der Ghost ist viel zu gut im Löschen.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -68, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Aber ganz löschen kann er nicht. Eines Tages sehen wir ihn ganz bestimmt.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "normal", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -69, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Ich frag mich, was das war. Dieses Licht.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "thinking", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -70, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "...Das weiß ich auch noch nicht.", :shotlist.episode11.de/shiro_emo "thinking", :shotlist.episode11.de/pico_emo "thinking", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -71, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Früher war ich gut im Logs-Löschen. Damit es keiner merkt.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -72, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "...Aber heute ist nichts weg. Alles ist noch da.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -73, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "...Ob das, was ich getan hab, auch noch da ist.", :shotlist.episode11.de/shiro_emo "sad", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -74, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Los, PICO. —Auf zur nächsten Stadt.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "sad", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -75, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "...Wenn's nicht weg ist, muss ich mich dem stellen.", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "thinking", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -76, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "geothermal_plant_dawn", :shotlist.episode11.de/scene_prompt "Distant plant view in morning light, for one instant white heat-haze forms a faceless humanoid silhouette then vanishes, a single teal mote glowing within its outline before fading, ominous mysterious cyber neon, To be continued", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx "flash", :shotlist.episode11.de/dur 3.5} {:db/id -77, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "zukan_corner", :shotlist.episode11.de/scene_prompt "Bright clean whiteboard channel-style corner, friendly studio lighting, a hand cupping glowing white light particles, teal accent graphics, cheerful educational cyber vibe, character-free", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 2.5} {:db/id -78, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Was ist denn heute das \"data remanence\"?!", :shotlist.episode11.de/shiro_emo "normal", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "pop", :shotlist.episode11.de/fx nil} {:db/id -79, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Data remanence = Datenrückstand. Auch gelöscht bleibt eine Spur.", :shotlist.episode11.de/shiro_emo "happy", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -80, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Das Landauer-Prinzip. Löschen kostet immer Wärme.", :shotlist.episode11.de/shiro_emo "happy", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -81, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "pico", :shotlist.episode11.de/text "Also wird man erwischt, selbst wenn ein Log weg ist?", :shotlist.episode11.de/shiro_emo "happy", :shotlist.episode11.de/pico_emo "confused", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -82, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Genau. Forensics-Tools holen die Spuren wieder hervor.", :shotlist.episode11.de/shiro_emo "happy", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx nil, :shotlist.episode11.de/fx nil} {:db/id -83, :shotlist.episode11.de/type "dialogue", :shotlist.episode11.de/speaker "shiro", :shotlist.episode11.de/text "Information ist physisch. Auch gelöscht bleibt das Licht.", :shotlist.episode11.de/shiro_emo "happy", :shotlist.episode11.de/pico_emo "happy", :shotlist.episode11.de/sfx "chime", :shotlist.episode11.de/fx "flash"} {:db/id -84, :shotlist.episode11.de/type "scene", :shotlist.episode11.de/scene_key "ed_hideandseek", :shotlist.episode11.de/scene_prompt "Soft teal cyber dusk ED scene, a faceless white heat-haze Ghost silhouette peeking shyly then hiding, within its outline a single teal mote of light stays glowing and does not fade, gentle ominous warmth, neon", :shotlist.episode11.de/sfx "ghost", :shotlist.episode11.de/fx nil, :shotlist.episode11.de/dur 3.0}]