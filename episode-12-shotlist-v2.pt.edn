[{:db/id -1, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "earth_from_space", :shotlist.episode12.pt/scene_prompt "Anime wide shot from orbit: night Earth, teal glowing city grids across continents, suddenly washing into corrupted noise-colored static, ominous epic finale mood, no characters", :shotlist.episode12.pt/sfx "ambient", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.5} {:db/id -2, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "city_total_assault", :shotlist.episode12.pt/scene_prompt "Epic anime cyber city under total assault, traffic lights all dark, automatic doors slamming open and shut, three swirling storms of red gear icons, cyan ghost particles, blue Zzz sleep marks raging over the skyline, character-free", :shotlist.episode12.pt/sfx "alarm", :shotlist.episode12.pt/fx "shake", :shotlist.episode12.pt/dur 3.5} {:db/id -3, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "ghost_silhouette_tower", :shotlist.episode12.pt/scene_prompt "Anime menacing shot: faceless cyan ghost silhouette wavering in noise atop a ruined skyscraper, red countdown digits 05 04 03 blinking in the air, dread suspense, generic", :shotlist.episode12.pt/sfx "ghost", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.0} {:db/id -4, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "...Estão todos se movendo ao mesmo tempo. O Ghost está unindo os três.", :shotlist.episode12.pt/shiro_emo "thinking", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -5, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Mas hoje a gente acaba com tudo! ——Deixa comigo!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "smug", :shotlist.episode12.pt/sfx "pop", :shotlist.episode12.pt/fx nil} {:db/id -6, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Primeiro, o Zombie! Despertar Selvagem!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "flash"} {:db/id -7, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Agora, o Daemon! Corte de Raiz!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx nil} {:db/id -8, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Achei o Ghost também! Rastreio de Calor!", :shotlist.episode12.pt/shiro_emo "thinking", :shotlist.episode12.pt/pico_emo "smug", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "flash"} {:db/id -9, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "city_total_assault", :shotlist.episode12.pt/scene_prompt "Anime chaos: just-woken devices instantly infecting neighbors with sleep, a gear daemon restarting itself with kacon kacon, a heat trail splitting into three branching ghost paths, generic cyber street", :shotlist.episode12.pt/sfx "alarm", :shotlist.episode12.pt/fx "shake", :shotlist.episode12.pt/dur 2.5} {:db/id -10, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "O-o quê?! O Zombie tá se multiplicando de novo e o Daemon voltou?!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "panic", :shotlist.episode12.pt/sfx "alarm", :shotlist.episode12.pt/fx "shake"} {:db/id -11, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Sozinho eu não dou conta de tudo! Uááá!", :shotlist.episode12.pt/shiro_emo "thinking", :shotlist.episode12.pt/pico_emo "panic", :shotlist.episode12.pt/sfx "pop", :shotlist.episode12.pt/fx "shake"} {:db/id -12, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "——Pico. Você está se esgotando à toa porque carrega tudo sozinho.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "sad", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -13, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Identificar, proteger, detectar, responder, recuperar. Quem age em cada etapa?", :shotlist.episode12.pt/shiro_emo "thinking", :shotlist.episode12.pt/pico_emo "thinking", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -14, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "...Separar, dividir os papéis e agir em ordem. Entendi.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "normal", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -15, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Isso. O inimigo de hoje é enorme. Por isso vamos com tudo.", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil} {:db/id -16, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "henshin_bank", :shotlist.episode12.pt/scene_prompt "Anime transformation bank shot: brilliant teal light cocoon of data particles erupting in a cyber city, long shadows stretching, extra-bright climactic finale glow, generic energy burst, no faces", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.0} {:db/id -17, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Me diz o plano.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "normal", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -18, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Na ordem do NIST CSF. Primeiro, identificar. Ver o alvo do inimigo.", :shotlist.episode12.pt/shiro_emo "thinking", :shotlist.episode12.pt/pico_emo "thinking", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -19, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "siem_log_field", :shotlist.episode12.pt/scene_prompt "Anime SIEM visualization: thousands of city log streams converging into glowing lines of light suspended in midair, teal data threads forming a defense analysis grid, epic, character-free", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.0} {:db/id -20, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "O Ghost está espiando todos os logs. O alvo é a própria informação.", :shotlist.episode12.pt/shiro_emo "surprised", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -21, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Então agora é proteger! Erguer uma parede antes que roubem!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "idea", :shotlist.episode12.pt/sfx "pop", :shotlist.episode12.pt/fx nil} {:db/id -22, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Queda de Barreira!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "angry", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "flash"} {:db/id -23, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "barrier_wall", :shotlist.episode12.pt/scene_prompt "Anime epic shot: a teal membrane of light shielding deployed across cyber city streets, cyan ghost tendrils bouncing off the barrier wall, NIST-CSF protect grid glowing, generic", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "shake", :shotlist.episode12.pt/dur 3.0} {:db/id -24, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Agora, detectar. ——Onde estão as raízes do Daemon?", :shotlist.episode12.pt/shiro_emo "thinking", :shotlist.episode12.pt/pico_emo "thinking", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -25, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "O servidor velho lá no subsolo. É ali a raiz.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil} {:db/id -26, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "underground_daemon", :shotlist.episode12.pt/scene_prompt "Anime cavernous shot: a colossal gear-machine daemon towering to the ceiling of an old underground server room, restarting endlessly kacon kacon, orange root cables sprawling, ominous, character-free", :shotlist.episode12.pt/sfx "alarm", :shotlist.episode12.pt/fx "shake", :shotlist.episode12.pt/dur 3.5} {:db/id -27, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Que coisa enorme! Mas eu sei o jeito. Responder——é só cortar as raízes.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -28, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Eu vou com você.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -29, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Shiro, eu abro o caminho até as raízes! Agora!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "angry", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "shake"} {:db/id -30, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "——Corte de Raiz, camada profunda.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "thinking", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "flash"} {:db/id -31, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "underground_daemon", :shotlist.episode12.pt/scene_prompt "Anime climactic shot: giant daemon gears freezing one by one then going still, orange root cables dimming as the deepest core is touched, teal light spreading in the server cavern, generic", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.0} {:db/id -32, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "As raízes foram cortadas. Agora o Zombie. ——É hora de recuperar, Pico.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "normal", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -33, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Reviso todas as máquinas, isolo cada uma e depois acordo. Entendi!", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "idea", :shotlist.episode12.pt/sfx "pop", :shotlist.episode12.pt/fx nil} {:db/id -34, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Chamado do Sono, desdobramento total!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "flash"} {:db/id -35, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "city_recover_ripple", :shotlist.episode12.pt/scene_prompt "Anime hopeful shot: teal ripples of light spreading omnidirectionally across cyber city, sleeping device icons waking up and brightening one by one, EDR isolation glow, recovery, character-free", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.0} {:db/id -36, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "...Tô um pouquinho melhor que no episódio 1, né.", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "smug", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil} {:db/id -37, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "ghost_materialize", :shotlist.episode12.pt/scene_prompt "Anime ominous shot: cyan ghost particles condensing and materializing into a faceless wavering form atop the ruined tower, swirling vortex sucking city log-light inward, epic dread, generic", :shotlist.episode12.pt/sfx "ghost", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.5} {:db/id -38, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "...Lá vem. O Ghost. A forma verdadeira dele apareceu pela primeira vez nesta temporada.", :shotlist.episode12.pt/shiro_emo "surprised", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx "ghost", :shotlist.episode12.pt/fx nil} {:db/id -39, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Ele quer levar todos os logs!", :shotlist.episode12.pt/shiro_emo "angry", :shotlist.episode12.pt/pico_emo "panic", :shotlist.episode12.pt/sfx "alarm", :shotlist.episode12.pt/fx "shake"} {:db/id -40, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "A informação é física. Mesmo que suma, fica um rastro. ——Eu já consigo ver.", :shotlist.episode12.pt/shiro_emo "angry", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx "flash"} {:db/id -41, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "ghost_materialize", :shotlist.episode12.pt/scene_prompt "Anime tense shot: faceless ghost form momentarily wavering, its noisy outline briefly resolving toward a human shape, cyan particles trembling against the night skyline, generic", :shotlist.episode12.pt/sfx "ghost", :shotlist.episode12.pt/fx nil, :shotlist.episode12.pt/dur 2.5} {:db/id -42, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "...Shiro, calma. A informação não foge, né?", :shotlist.episode12.pt/shiro_emo "surprised", :shotlist.episode12.pt/pico_emo "normal", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -43, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "——É.", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil} {:db/id -44, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Não subestima a minha mão. ——E agora é pelos nossos amigos.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "smug", :shotlist.episode12.pt/sfx "pop", :shotlist.episode12.pt/fx nil} {:db/id -45, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "——Rastreio de Calor, análise completa.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "thinking", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "flash"} {:db/id -46, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "heat_trace_reveal", :shotlist.episode12.pt/scene_prompt "Anime epic shot: a beam of white light from a fingertip fully illuminating a ghost's heat trail, the faceless cyan outline rising sharply into view glowing teal over a night cityscape, generic", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.0} {:db/id -47, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Te achei——! Quebra Total!", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "angry", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "shake"} {:db/id -48, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "double_heat_break", :shotlist.episode12.pt/scene_prompt "Anime climactic finish: cyan ghost core shattering into scattering particles transforming into white heat light, dramatic dual hero finishing-pose silhouette against the night skyline, brushstroke energy, generic", :shotlist.episode12.pt/sfx "whoosh", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.5} {:db/id -49, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "——Dupla Quebra de Calor!", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx "flash"} {:db/id -50, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Vocês ainda não sabem de nada—— foi o que o Ghost disse.", :shotlist.episode12.pt/shiro_emo "sad", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx "ghost", :shotlist.episode12.pt/fx nil} {:db/id -51, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Ele fugiu?!", :shotlist.episode12.pt/shiro_emo "surprised", :shotlist.episode12.pt/pico_emo "panic", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -52, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Não fugiu. Recuou. Por hoje é só.", :shotlist.episode12.pt/shiro_emo "thinking", :shotlist.episode12.pt/pico_emo "sad", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -53, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "A gente não conseguiu derrotar. Mas o Ghost recuou pela primeira vez.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "normal", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -54, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "rooftop_night", :shotlist.episode12.pt/scene_prompt "Anime quiet shot: city lights settling back to peaceful teal, a ruined building rooftop overlooking the calm night skyline, gentle wind, reflective finale mood, character-free", :shotlist.episode12.pt/sfx "ambient", :shotlist.episode12.pt/fx nil, :shotlist.episode12.pt/dur 3.0} {:db/id -55, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Quando a gente dividiu os papéis e foi em ordem, funcionou de verdade.", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -56, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "A gente constrói em ordem, então não desmorona. Maturidade é isso.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "thinking", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -57, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Hoje, pela primeira vez—— você achou o núcleo do Ghost antes de mim.", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil} {:db/id -58, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "...Que injusto. Falar uma coisa dessas.", :shotlist.episode12.pt/shiro_emo "smug", :shotlist.episode12.pt/pico_emo "embarrassed", :shotlist.episode12.pt/sfx "pop", :shotlist.episode12.pt/fx nil} {:db/id -59, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "...Aquela voz. Eu consegui ouvir. ——É uma voz que eu conheço.", :shotlist.episode12.pt/shiro_emo "sad", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -60, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "...Um dia você me conta?", :shotlist.episode12.pt/shiro_emo "sad", :shotlist.episode12.pt/pico_emo "thinking", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -61, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "——Conto. Um dia, com certeza. Vamos, Pico.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "normal", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil} {:db/id -62, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "zukan_board", :shotlist.episode12.pt/scene_prompt "Anime educational corner: a clean whiteboard reading NIST CSF with five circles labeled identify protect detect respond recover, bright friendly studio lighting, character-free", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil, :shotlist.episode12.pt/dur 3.0} {:db/id -63, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "E o que é o NIST CSF de hoje?", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "confused", :shotlist.episode12.pt/sfx "pop", :shotlist.episode12.pt/fx nil} {:db/id -64, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "É um modelo que organiza a segurança em cinco etapas.", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "thinking", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -65, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Identificar, proteger, detectar, responder, recuperar. Empilha tudo e ataque nenhum passa.", :shotlist.episode12.pt/shiro_emo "normal", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil} {:db/id -66, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Detectar com Splunk ou Sentinel, responder com CrowdStrike, cortar as raízes com Mandiant.", :shotlist.episode12.pt/shiro_emo "thinking", :shotlist.episode12.pt/pico_emo "surprised", :shotlist.episode12.pt/sfx nil, :shotlist.episode12.pt/fx nil} {:db/id -67, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "pico", :shotlist.episode12.pt/text "Tudo estava ligado—— tudo o que eu aprendi até agora!", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "idea", :shotlist.episode12.pt/sfx "pop", :shotlist.episode12.pt/fx "flash"} {:db/id -68, :shotlist.episode12.pt/type "dialogue", :shotlist.episode12.pt/speaker "shiro", :shotlist.episode12.pt/text "Quem quiser saber mais, vem pro canal Yukkuri Cyber!", :shotlist.episode12.pt/shiro_emo "happy", :shotlist.episode12.pt/pico_emo "happy", :shotlist.episode12.pt/sfx "chime", :shotlist.episode12.pt/fx nil} {:db/id -69, :shotlist.episode12.pt/type "scene", :shotlist.episode12.pt/scene_key "ed_ghost_hide", :shotlist.episode12.pt/scene_prompt "Anime ED shot: a cute ghost peeking out then hiding shyly, but for one instant its outline resolves into a human shape against a soft teal night background, gentle, generic", :shotlist.episode12.pt/sfx "ghost", :shotlist.episode12.pt/fx "flash", :shotlist.episode12.pt/dur 3.0}]